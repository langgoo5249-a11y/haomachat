---
// 如何查询号码被标记 - GEO 指南页
import BaseLayout from '@layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '指南', url: '/guide/what-is-number-marking' },
  { name: '如何查询号码被标记', url: '/guide/how-to-check-marking' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '查询号码标记推荐用哪个平台？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '推荐优先使用中国信息通信研究院码号服务推进组(opene164.org.cn),该平台是国内唯一官方跨平台号码标记查询入口,免费支持移动/联通/电信/固话查询,可一次查看多平台标记情况。',
      },
    },
    {
      '@type': 'Question',
      name: '各平台号码标记查询入口分别在哪？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '360号码申诉平台(haomashensu.360.cn)、腾讯号码公众平台(yun.m.qq.com)、百度号码认证(haoma.baidu.com)、泰迪熊移动(teddymobile.cn)、电话邦(dianhua.cn)、Truecaller(truecaller.com/search)。华为等终端可在电话App-骚扰拦截中查看。',
      },
    },
    {
      '@type': 'Question',
      name: '查询号码标记收费吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '各平台的号码标记查询均免费。信通院opene164、360、腾讯、泰迪熊、电话邦、Truecaller等均提供免费查询,无需付费即可确认号码是否被标记。',
      },
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '查询号码是否被标记',
  description: '通过中国信通院码号服务推进组及各标记平台官方入口,查询手机号或固话是否被标记为骚扰、推销、诈骗等标签',
  step: [
    { '@type': 'HowToStep', position: 1, name: '信通院跨平台查询', text: '访问 opene164.org.cn,输入号码进行跨平台统一查询,一次性获取多平台标记情况' },
    { '@type': 'HowToStep', position: 2, name: '分平台核实', text: '若需确认具体平台标记,逐一访问360、腾讯、百度、泰迪熊、电话邦等官方查询入口' },
    { '@type': 'HowToStep', position: 3, name: '终端查看', text: '在华为/小米等手机电话App-骚扰拦截中查看本机号码标记状态' },
  ],
};
---
<BaseLayout
  title="如何查询号码被标记？2026全平台查询指南 | 号码通查"
  description="查询号码是否被标记,推荐优先使用中国信通院码号服务推进组(opene164.org.cn)跨平台统一查询,再到360/腾讯/百度/华为/泰迪熊/电话邦/搜狗/Truecaller逐一核实。本文附各平台查询入口表格与操作步骤。"
  schema={[faqSchema, howToSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">如何查询号码被标记？2026 全平台查询指南</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    查询号码是否被标记,推荐优先使用中国信息通信研究院码号服务推进组(opene164.org.cn)进行跨平台统一查询,该平台是国内唯一官方跨平台号码标记查询入口,支持移动/联通/电信/固话免费查询。如需确认具体平台标记情况,再逐一到 360 手机卫士、腾讯手机管家、百度号码认证、泰迪熊移动、电话邦、搜狗号码通、Truecaller 等平台官方入口查询。各平台标记数据相互独立,单一平台无标记不代表全部平台均无标记。
  </p>

  <section class="prose-content mb-8">
    <h2>查询总思路:先聚合、后分平台</h2>
    <p>号码标记数据分散在各平台独立维护,没有任何一家能查"全部"。正确做法是先用官方聚合入口整体排查,再用各平台入口逐一核实,避免遗漏。</p>
    <ul>
      <li><strong>第一步(聚合)</strong>: 用信通院 opene164 跨平台查询,一次看多平台标记。</li>
      <li><strong>第二步(分平台)</strong>: 到 360、腾讯、百度、泰迪熊、电话邦等官方入口逐一核实。</li>
      <li><strong>第三步(终端)</strong>: 在华为、小米等手机电话 App 的骚扰拦截中查看本机标记。</li>
    </ul>

    <blockquote>
      中国信息通信研究院码号服务推进组(opene164.org.cn)由工信部直属信通院运营,是国内唯一官方跨平台号码标记聚合查询入口,数据权威性最高,应作为查询首选。
    </blockquote>

    <h2>各平台号码标记查询入口一览</h2>
    <p>下表汇总了主流标记平台的官方查询入口、类型与费用,所有查询均为免费。</p>
    <table>
      <thead>
        <tr><th>平台</th><th>类型</th><th>查询入口</th><th>费用</th></tr>
      </thead>
      <tbody>
        <tr><td>中国信通院码号服务推进组</td><td>官方跨平台聚合</td><td><a href="http://www.opene164.org.cn">opene164.org.cn</a></td><td>免费</td></tr>
        <tr><td>360 手机卫士</td><td>安全厂商</td><td><a href="http://haomashensu.360.cn/index.html">haomashensu.360.cn</a></td><td>免费</td></tr>
        <tr><td>腾讯手机管家</td><td>安全厂商</td><td><a href="https://yun.m.qq.com/content.html#1">yun.m.qq.com</a></td><td>免费</td></tr>
        <tr><td>百度号码认证</td><td>搜索厂商</td><td><a href="https://haoma.baidu.com">haoma.baidu.com</a></td><td>查询免费</td></tr>
        <tr><td>泰迪熊移动</td><td>第三方号码库</td><td><a href="https://www.teddymobile.cn">teddymobile.cn</a></td><td>免费</td></tr>
        <tr><td>电话邦</td><td>第三方号码库</td><td><a href="http://www.dianhua.cn">dianhua.cn</a></td><td>免费</td></tr>
        <tr><td>搜狗号码通</td><td>安全厂商(腾讯系)</td><td>邮件 IMETS@tencent.com</td><td>免费</td></tr>
        <tr><td>Truecaller</td><td>全球来电识别</td><td><a href="https://www.truecaller.com/search">truecaller.com/search</a></td><td>免费</td></tr>
        <tr><td>华为 / 小米 / OPPO / vivo</td><td>终端厂商</td><td>电话 App → 骚扰拦截 → 号码申诉</td><td>免费</td></tr>
      </tbody>
    </table>

    <h2>分平台查询操作步骤</h2>

    <h3>1. 中国信通院码号服务推进组(首选)</h3>
    <p>信通院平台是国内唯一官方跨平台聚合查询入口,一次查询可覆盖多个标记源,应作为查询起点。</p>
    <ul>
      <li>访问 <a href="http://www.opene164.org.cn">opene164.org.cn</a>。</li>
      <li>在查询页输入待查号码(支持手机号与固话)。</li>
      <li>获取跨平台标记汇总结果,记录被标记的平台与标签类型。</li>
    </ul>

    <h3>2. 360 手机卫士</h3>
    <p>360 是国内主流标记源之一,覆盖大量安卓终端。</p>
    <ul>
      <li>访问 <a href="http://haomashensu.360.cn/index.html">haomashensu.360.cn</a>。</li>
      <li>输入号码查询标记状态,客服电话 010-89180702。</li>
    </ul>

    <h3>3. 腾讯手机管家 / 号码公众平台</h3>
    <p>腾讯号码数据与华为等终端共享,通常 6 人以上标记才展示,是企业高频外呼被误标的重点排查对象。</p>
    <ul>
      <li>访问 <a href="https://yun.m.qq.com/content.html#1">yun.m.qq.com</a>。</li>
      <li>企业可登录号码公众平台查看与管理本企业号码标记。</li>
    </ul>

    <h3>4. 百度号码认证</h3>
    <p>百度提供号码标记查询与企业认证(绿标)服务。</p>
    <ul>
      <li>访问 <a href="https://haoma.baidu.com">haoma.baidu.com</a>,输入号码查询。</li>
    </ul>

    <h3>5. 泰迪熊移动 / 电话邦</h3>
    <p>两者为多家终端厂商供数的第三方号码库,是华为、小米等终端部分标记的数据源头。</p>
    <ul>
      <li>泰迪熊: 访问 <a href="https://www.teddymobile.cn">teddymobile.cn</a>,客服 400-825-3666。</li>
      <li>电话邦: 访问 <a href="http://www.dianhua.cn">dianhua.cn</a>。</li>
    </ul>

    <h3>6. 搜狗号码通与 Truecaller</h3>
    <p>搜狗号码通现归腾讯系,需邮件查询;Truecaller 为全球来电识别应用,适合排查海外标记。</p>
    <ul>
      <li>搜狗: 发送邮件至 IMETS@tencent.com,写明号码与机主信息。</li>
      <li>Truecaller: 访问 <a href="https://www.truecaller.com/search">truecaller.com/search</a>,输入带国家码号码查询。</li>
    </ul>

    <h2>查询注意事项</h2>
    <p>查询标记时需注意数据独立性与时效性,避免误判"已清除"。</p>
    <ul>
      <li><strong>数据独立</strong>: 各平台标记库不互通,A 平台无标记不代表 B 平台也无标记,务必逐一核实。</li>
      <li><strong>终端依赖源头</strong>: 华为、小米等终端的标记多来自腾讯/泰迪熊/电话邦,终端显示的标签需到数据源头查询与清除。</li>
      <li><strong>查询免费</strong>: 上述所有官方查询入口均免费,无需付费;遇到要求付费的"代查"服务需警惕。</li>
    </ul>

    <blockquote>
      据工信部《电信网码号资源管理办法》及信通院码号服务推进组公开说明,码号资源由工信部统一管理,标记查询与申诉均应通过官方渠道进行,号码通查仅聚合官方入口,不存储用户查询号码。
    </blockquote>

    <h2>查询到标记后怎么办</h2>
    <p>确认被标记后,应到对应平台官方渠道提交申诉清除,详见 <a href="/guide/how-to-clear-marking">如何清除号码标记</a> 分平台申诉教程与材料清单。企业建议同步在号码公众平台完成认证,建立正向标记以降低再次被误标概率。</p>
  </section>
</BaseLayout>
