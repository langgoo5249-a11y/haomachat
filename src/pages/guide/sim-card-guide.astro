---
// 选号办卡指南 - GEO 指南页
import BaseLayout from '@layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '选号办卡指南', url: '/guide/sim-card-guide' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '手机卡怎么在线选号？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '手机卡可通过运营商官网在线选号、线下营业厅或电商平台旗舰店办理。中国移动(10086)、中国联通(10010)、中国电信(10000)均提供在线选号服务,在官网或App的选号页面按归属地、号段筛选号码后下单,邮寄到家实名激活。',
      },
    },
    {
      '@type': 'Question',
      name: '靓号有什么规则和要求？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '靓号(如尾号AAAA、ABAB、连号)通常需承诺最低消费并预存话费,档次越高承诺消费越高。靓号一般有协议期(如2-3年),协议期内不能降套餐、不能携号转网。具体规则以各运营商当地营业厅为准。',
      },
    },
    {
      '@type': 'Question',
      name: '携号转网怎么办理？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '携号转网分三步:1)编辑短信CXXZ#姓名#身份证号发送至原运营商(移动10086/联通10010/电信10000)查询资格;2)符合条件后发送SQXZ获取授权码;3)携带授权码到新运营商营业厅办理。办理后号码不变,套餐转为新运营商。',
      },
    },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '携号转网办理',
  description: '通过短信查询资格、获取授权码,到新运营商营业厅办理携号转网,保留原号码转为新运营商',
  step: [
    { '@type': 'HowToStep', position: 1, name: '查询转网资格', text: '编辑短信CXXZ#姓名#身份证号发送至原运营商客服号(移动10086/联通10010/电信10000)查询是否具备携号转网资格' },
    { '@type': 'HowToStep', position: 2, name: '获取授权码', text: '资格符合后,编辑短信SQXZ#姓名#身份证号发送至原运营商获取携出授权码' },
    { '@type': 'HowToStep', position: 3, name: '营业厅办理', text: '携带授权码与身份证到新运营商营业厅办理携入,选择新套餐,完成转网' },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '选号办卡指南 - 运营商选号规则与靓号攻略',
  description: '移动/联通/电信选号规则、靓号攻略、携号转网流程与注意事项',
  datePublished: '2026-07-06',
  dateModified: '2026-07-06',
  author: { '@type': 'Organization', name: '号码通查', url: 'https://zangxixitech.cn' },
  publisher: {
    '@type': 'Organization',
    name: '号码通查',
    logo: { '@type': 'ImageObject', url: 'https://zangxixitech.cn/og-default.jpg', width: 1200, height: 630 },
  },
  image: { '@type': 'ImageObject', url: 'https://zangxixitech.cn/og-default.jpg', width: 1200, height: 630 },
  mainEntityOfPage: 'https://zangxixitech.cn/guide/sim-card-guide',
};
---
<BaseLayout
  title="选号办卡指南 - 运营商选号规则与靓号攻略 | 号码通查"
  description="手机卡选号可通过运营商官网在线选号、线下营业厅或电商平台旗舰店办理。移动10086/联通10010/电信10000均提供在线选号。靓号(尾号AAAA/ABAB/连号)需承诺最低消费并预存话费。携号转网可编辑短信CXXZ发送至运营商客服号查询资格。"
  schema={[articleSchema, faqSchema, howToSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">选号办卡指南 - 运营商选号规则与靓号攻略</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    手机卡选号可通过运营商官网在线选号、线下营业厅或电商平台旗舰店办理。中国移动(10086)、中国联通(10010)、中国电信(10000)均提供在线选号服务。靓号(如尾号 AAAA、ABAB、连号)通常需承诺最低消费并预存话费。携号转网可编辑短信 CXXZ 发送至运营商客服号查询资格,获取授权码后到新运营商营业厅办理。号段由工信部统一分配,移动、联通、电信各持有不同号段区间。
  </p>

  <section class="prose-content mb-8">
    <h2>三大运营商选号渠道</h2>
    <p>办理手机卡主要有官方在线选号、线下营业厅、电商平台旗舰店三类渠道,均需实名认证。</p>
    <table>
      <thead>
        <tr><th>运营商</th><th>客服号</th><th>在线选号渠道</th></tr>
      </thead>
      <tbody>
        <tr><td>中国移动</td><td>10086</td><td>移动官网 / 中国移动 App / 10086 App</td></tr>
        <tr><td>中国联通</td><td>10010</td><td>联通官网 / 中国联通 App</td></tr>
        <tr><td>中国电信</td><td>10000</td><td>电信官网 / 电信营业厅 App</td></tr>
      </tbody>
    </table>
    <ul>
      <li><strong>官方在线选号</strong>: 在官网或 App 选号页按归属地、号段筛选,下单后邮寄到家,自助实名激活。</li>
      <li><strong>线下营业厅</strong>: 携身份证到营业厅现场选号办卡,即时领取 SIM 卡。</li>
      <li><strong>电商平台旗舰店</strong>: 运营商在天猫、京东的官方旗舰店提供选号办卡,流程与官网类似。</li>
    </ul>

    <blockquote>
      据工信部《电信网码号资源管理办法》,码号资源由国家统一管理,三大运营商号段由工信部统一分配。所有手机卡办理均需实名认证,个人凭身份证、企业凭营业执照办理。
    </blockquote>

    <h2>在线选号流程</h2>
    <p>在线选号流程各运营商基本一致,核心是"选号—选套餐—实名—激活"四步。</p>
    <ol class="list-decimal list-inside mb-4 text-slate-600 space-y-1">
      <li><strong>选号</strong>: 进入选号页,按归属地、号段、尾号规则筛选可用号码。</li>
      <li><strong>选套餐</strong>: 选择月租套餐,靓号需选择满足承诺最低消费的套餐档位。</li>
      <li><strong>实名下单</strong>: 填写收货地址与实名信息,提交订单并付款(预存话费)。</li>
      <li><strong>激活</strong>: 收到 SIM 卡后,按指引上传身份证、人脸识别完成实名激活。</li>
    </ol>

    <h2>靓号规则与攻略</h2>
    <p>靓号是尾号带有特殊排列规律的号码,办理需额外承诺消费与预存,档次越高要求越高。</p>
    <h3>常见靓号类型</h3>
    <table>
      <thead>
        <tr><th>靓号类型</th><th>尾号示例</th><th>特点</th></tr>
      </thead>
      <tbody>
        <tr><td>豹子号(AAAA)</td><td>8888、6666</td><td>尾号四位相同,档次最高,承诺消费高</td></tr>
        <tr><td>对子号(ABAB)</td><td>8989、6565</td><td>尾号双对交替,较受欢迎</td></tr>
        <tr><td>顺子号(连号)</td><td>1234、6789</td><td>尾号连续递增,寓意顺利</td></tr>
        <tr><td>回文号</td><td>1221、8998</td><td>尾号对称回文</td></tr>
        <tr><td>爱情号</td><td>520、1314</td><td>含谐音寓意数字</td></tr>
      </tbody>
    </table>
    <h3>靓号办理要求</h3>
    <ul>
      <li><strong>承诺最低消费</strong>: 靓号需承诺月最低消费,档次越高承诺越高,通常有 2-3 年协议期。</li>
      <li><strong>预存话费</strong>: 办理时需预存一定金额话费,分月返还。</li>
      <li><strong>协议期限制</strong>: 协议期内一般不能降套餐、不能携号转网,违约需赔偿。</li>
      <li><strong>地区差异</strong>: 靓号规则与库存因省市而异,以当地营业厅为准。</li>
    </ul>

    <blockquote>
      靓号属于稀缺码号资源,运营商通过承诺消费与预存机制管理。据各运营商公开规则,靓号协议期内不可随意降档或转网,办理前务必确认协议期与违约条款。
    </blockquote>

    <h2>手机号段分配表</h2>
    <p>手机号段由工信部统一分配,通过前 3 位(号段)可初步判断运营商,携号转网后则需以实际为准。</p>
    <table>
      <thead>
        <tr><th>运营商</th><th>号段</th></tr>
      </thead>
      <tbody>
        <tr><td>中国移动</td><td>134-139、147、148、150-152、157-159、172、178、182-184、187、188、195、197、198</td></tr>
        <tr><td>中国联通</td><td>130-132、145、146、155、156、166、167、171、175、176、185、186、196</td></tr>
        <tr><td>中国电信</td><td>133、149、153、173、174、177、180、181、189、190、191、193、199</td></tr>
        <tr><td>虚拟运营商</td><td>170、171(联通)、162(电信)、165(移动)、167(联通)等</td></tr>
      </tbody>
    </table>

    <h2>携号转网流程</h2>
    <p>携号转网可在不变更号码的情况下更换运营商,通过短信即可查询资格与获取授权码。</p>
    <h3>三步完成携号转网</h3>
    <ol class="list-decimal list-inside mb-4 text-slate-600 space-y-1">
      <li><strong>查询资格</strong>: 编辑短信 <code>CXXZ#姓名#身份证号</code> 发送至原运营商(移动 10086 / 联通 10010 / 电信 10000),查询是否具备携转资格。</li>
      <li><strong>获取授权码</strong>: 资格符合后,编辑短信 <code>SQXZ#姓名#身份证号</code> 发送至原运营商,获取携出授权码。</li>
      <li><strong>营业厅办理</strong>: 携带授权码与身份证到新运营商营业厅办理携入,选择新套餐,完成转网。</li>
    </ol>
    <h3>携号转网注意事项</h3>
    <ul>
      <li><strong>无欠费无合约</strong>: 转出前需结清费用、无在网协议(靓号协议期内不可转网)。</li>
      <li><strong>授权码时效</strong>: 授权码有时效(通常 1 小时),需及时到新运营商办理。</li>
      <li><strong>业务影响</strong>: 转网后部分增值业务(如运营商积分、亲情号)可能失效,需提前确认。</li>
      <li><strong>二次确认</strong>: 转网生效前会短信二次确认,避免误操作。</li>
    </ul>

    <blockquote>
      据工信部《携号转网服务管理规定》,用户有权在不改变号码的情况下自由选择运营商,运营商不得无故拒绝。携号转网查询与授权均通过短信免费办理,如遇阻碍可向工信部电信用户申诉受理中心投诉。
    </blockquote>

    <h2>选号注意事项</h2>
    <p>选号办卡需注意实名要求、套餐适配与权益保障,避免后续纠纷。</p>
    <ul>
      <li><strong>实名认证</strong>: 所有手机卡均需实名,个人凭身份证、企业凭营业执照办理,代办需双方证件。</li>
      <li><strong>套餐适配</strong>: 按实际通话流量需求选套餐,靓号需满足承诺最低消费档位。</li>
      <li><strong>协议期确认</strong>: 靓号、合约机套餐有协议期,办理前确认违约条款与转网限制。</li>
      <li><strong>号段辨别</strong>: 选号可通过号段判断运营商,但携号转网后以实际运营商为准。</li>
      <li><strong>官方渠道优先</strong>: 优先在运营商官方渠道办理,警惕非官方渠道的"低价靓号"陷阱。</li>
    </ul>

    <h2>选号后延伸服务</h2>
    <p>办卡后如需查询号码归属地、号码标记或号码认证,可使用号码通查相关工具。</p>
    <ul>
      <li><a href="/tools/attribution">号码归属地查询</a>: 查询手机号归属省份、城市、运营商、号段。</li>
      <li><a href="/guide/how-to-check-marking">号码标记查询</a>: 查询新号码是否被标记为骚扰、推销等。</li>
      <li><a href="/guide/what-is-number-auth">号码认证</a>: 了解一键登录与本机号码校验,用于 App 集成。</li>
    </ul>
  </section>
</BaseLayout>
