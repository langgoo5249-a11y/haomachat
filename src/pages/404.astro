---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="404 - 页面未找到 | 号码通查" description="您访问的页面不存在或已移动,请通过下方链接访问号码通查的热门页面。" noindex={true}>
  <div class="text-center py-12">
    <h1 class="text-6xl font-bold text-slate-300 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-2">您访问的页面不存在或已移动</p>
    <p class="text-sm text-slate-400 mb-8">别担心,以下是我们最常用的页面入口</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    <a href="/tools/marking-check" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">🏷️</div>
      <h2 class="font-semibold text-slate-800 mb-1">号码标记自查</h2>
      <p class="text-sm text-slate-500">查询手机号/座机号是否被标记</p>
    </a>
    <a href="/tools/marking-clear" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">✅</div>
      <h2 class="font-semibold text-slate-800 mb-1">号码标记清除</h2>
      <p class="text-sm text-slate-500">各官方平台申诉入口汇总</p>
    </a>
    <a href="/tools/attribution" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">🔍</div>
      <h2 class="font-semibold text-slate-800 mb-1">号码归属地查询</h2>
      <p class="text-sm text-slate-500">免费查询归属地与运营商</p>
    </a>
    <a href="/guide/how-to-clear-marking" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">📖</div>
      <h2 class="font-semibold text-slate-800 mb-1">清除标记教程</h2>
      <p class="text-sm text-slate-500">分平台申诉步骤与材料清单</p>
    </a>
    <a href="/blog" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">📚</div>
      <h2 class="font-semibold text-slate-800 mb-1">号码百科</h2>
      <p class="text-sm text-slate-500">深度文章与实战案例</p>
    </a>
    <a href="/faq" class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
      <div class="text-2xl mb-2">❓</div>
      <h2 class="font-semibold text-slate-800 mb-1">常见问题</h2>
      <p class="text-sm text-slate-500">高频问题快速解答</p>
    </a>
  </div>

  <div class="text-center">
    <a href="/" class="inline-block px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700">
      返回首页
    </a>
  </div>
</BaseLayout>
