---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="404 - 页面未找到 | 号码通查" description="您访问的页面不存在" noindex={true}>
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-slate-300 mb-4">404</h1>
    <p class="text-xl text-slate-600 mb-8">您访问的页面不存在或已移动</p>
    <a href="/" class="inline-block px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700">
      返回首页
    </a>
  </div>
</BaseLayout>
