---
// 中文首页 - 以号码标记清除为核心
import BaseLayout from '@layouts/BaseLayout.astro';
import faqData from '@data/faq.json';

const homeFaq = faqData.groups[0].items.slice(0, 6).map((item) => ({
  '@type': 'Question',
  name: item.q,
  acceptedAnswer: { '@type': 'Answer', text: item.a },
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq,
};

const serviceUrl = 'http://xbh5.open10086.com/?authorization=f91029a83a8758aa';
const verifyUrl = 'https://xbh5.open10086.com/factor/#/pages/index/index?authorization=f91029a83a8758aa';

const breadcrumbs = [{ name: '首页', url: '/' }];

// SVG 图标路径
const icons = {
  clear: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  verify: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  check: 'M3 5h2M3 9h2M3 13h2M3 17h2M9 5h12M9 9h12M9 13h12M9 17h12',
  location: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  sim: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
};

const tools = [
  { title: '号码标记清除', desc: '手机号与座机号均可清除误标记', href: '/tools/marking-clear', icon: icons.clear, primary: true },
  { title: '法人号码核验', desc: '企业法人手机号三要素实名核验', href: '/tools/legal-number-verify', icon: icons.verify, primary: true },
  { title: '号码标记自查', desc: '查询手机号/座机号被标记情况', href: '/tools/marking-check', icon: icons.check, primary: false },
  { title: '号码归属地查询', desc: '查手机号/固话归属地与运营商', href: '/tools/attribution', icon: icons.location, primary: false },
];

const guides = [
  { title: '号码标记是什么', desc: '标记来源、机制与显示规则', href: '/guide/what-is-number-marking' },
  { title: '如何查询号码被标记', desc: '全平台查询指南', href: '/guide/how-to-check-marking' },
  { title: '如何清除号码标记', desc: '分渠道申诉教程与材料清单', href: '/guide/how-to-clear-marking' },
  { title: '号码认证是什么', desc: '一键登录与本机号码校验原理', href: '/guide/what-is-number-auth' },
];
---
<BaseLayout
  title="号码通查 - 号码标记查询与清除(手机号/座机号均支持)"
  description="号码通查提供号码标记查询与清除服务,手机号码与座机(固话)号码均支持。聚合中国信通院码号服务推进组与Truecaller官方入口,一站式解决号码被误标记为骚扰电话的问题。"
  schema={[faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero 区 -->
  <section class="mb-10 pt-4">
    <div class="flex flex-col md:flex-row items-start gap-8">
      <div class="flex-1">
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4 title-underline">
          号码标记查询与清除
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed mb-6 mt-6">
          号码通查提供号码标记查询与清除服务,<strong>手机号码与座机(固话)号码均支持</strong>。号码被误标记为骚扰电话、推销电话后,可通过本站一键进入清除服务,同时聚合中国信通院码号服务推进组与Truecaller官方入口,多渠道彻底清除误标记。
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={serviceUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 transition-colors shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.clear}/></svg>
            立即清除标记
          </a>
          <a href={verifyUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-brand-700 border border-brand-300 rounded-lg font-medium hover:bg-brand-50 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.verify}/></svg>
            法人号码核验
          </a>
        </div>
      </div>
      <!-- 信任标签 -->
      <div class="w-full md:w-64 flex-shrink-0 space-y-2">
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          手机号 · 座机号 均支持
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          中国信通院官方数据
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          不存储号码数据
        </div>
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          查询免费
        </div>
      </div>
    </div>
  </section>

  <!-- 服务工具 -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-slate-800 mb-5">服务工具</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {tools.map((tool) => (
        <a href={tool.href} class={`card p-5 ${tool.primary ? 'ring-1 ring-brand-200' : ''}`}>
          <div class={`w-10 h-10 rounded-lg flex items-center justify-center mb-3 ${tool.primary ? 'bg-brand-600' : 'bg-slate-100'}`}>
            <svg class={`w-5 h-5 ${tool.primary ? 'text-white' : 'text-slate-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon}/></svg>
          </div>
          <h3 class="font-semibold text-slate-800 mb-1">{tool.title}</h3>
          <p class="text-sm text-slate-500">{tool.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 标记清除说明 -->
  <section class="prose-content mb-10">
    <h2>号码标记清除说明</h2>
    <p>
      号码标记是指手机来电时,终端安全软件根据号码库数据在来电界面显示"骚扰电话""推销"等标签的功能。当号码被误标记后,会影响正常通话与业务。号码通查提供<strong>手机号码与座机(固话)号码</strong>的标记查询与清除服务(注:诈骗类标记不在清除范围内),支持以下渠道:
    </p>
    <ul>
      <li><strong>标记清除服务入口</strong>:支持手机号与座机号,一站式查询并清除误标记,推荐优先使用。</li>
      <li><strong>中国信通院码号服务推进组</strong>(opene164.org.cn):国内唯一官方跨平台号码标记查询与清除入口,支持手机号与座机号免费查询,中国联通手机号可一站式清除。</li>
      <li><strong>Truecaller</strong>(truecaller.com):全球最大来电识别应用,适合有国际往来的号码,提交取消收录后24-48小时移除。</li>
    </ul>
  </section>

  <!-- 权威指南 -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-slate-800 mb-5">权威指南</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {guides.map((guide) => (
        <a href={guide.href} class="card p-4">
          <h3 class="font-medium text-slate-800 mb-1">{guide.title}</h3>
          <p class="text-sm text-slate-500">{guide.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-slate-800 mb-5">常见问题</h2>
    <div class="space-y-3">
      {faqData.groups[0].items.map((item) => (
        <div class="card p-4">
          <h3 class="font-semibold text-slate-800 mb-1 text-sm">{item.q}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm">
      <a href="/faq" class="text-brand-600 hover:underline">查看全部常见问题 →</a>
    </p>
  </section>

  <!-- 底部信任声明 -->
  <section class="bg-slate-100 rounded-xl p-6 border border-slate-200">
    <p class="text-sm text-slate-500 leading-relaxed">
      号码通查由脏兮兮科技运营。标记清除服务由授权合作方提供,官方数据来源为中国信息通信研究院码号服务推进组(opene164.org.cn)与Truecaller。本站不存储用户查询的号码数据,查询免费。如需帮助请<a href="/contact" class="text-brand-600 hover:underline">联系我们</a>。
    </p>
  </section>
</BaseLayout>
