---
// 号码标记清除 - 标记清除服务入口与官方平台
import BaseLayout from '@layouts/BaseLayout.astro';
import platformsData from '@data/platforms.json';

const platforms = platformsData.platforms;

const isUrl = (s: string) => /^https?:\/\//.test(s);

// 公司服务链接
const serviceUrl = 'http://xbh5.open10086.com/?authorization=f91029a83a8758aa';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码标记清除', url: '/tools/marking-clear' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '如何清除号码标记',
  description: '清除手机号码与座机号码被误标记为骚扰/诈骗电话的完整流程,支持手机号与固话。',
  totalTime: 'PT10M',
  step: [
    {
      '@type': 'HowToStep',
      name: '步骤一: 进入标记清除服务',
      text: '点击本页标记清除入口,输入您的手机号码或座机(固话)号码,系统将查询并支持清除误标记。手机号与座机号均支持,推荐优先使用。',
      url: serviceUrl,
    },
    {
      '@type': 'HowToStep',
      name: '步骤二: 到中国信通院码号服务推进组清除',
      text: '访问 opene164.org.cn,这是国内唯一官方跨平台号码标记清除入口。支持手机号与座机号查询;中国联通手机号可一站式清除误标记。',
      url: 'http://www.opene164.org.cn',
    },
    {
      '@type': 'HowToStep',
      name: '步骤三: Truecaller取消收录(海外标记)',
      text: '若号码有国际往来,访问 truecaller.com/unlisting,输入带国家码的号码与验证码,提交取消收录申请,通常24-48小时内移除。',
      url: 'https://www.truecaller.com/unlisting',
    },
    {
      '@type': 'HowToStep',
      name: '步骤四: 等待处理结果',
      text: '各渠道处理时间不同:标记清除服务与信通院通常1-3个工作日,Truecaller 24-48小时。处理完成后标记清除,来电不再显示错误标签。',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '座机号码能清除标记吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '可以。本站标记清除服务与中国信通院码号服务推进组均支持座机(固话)号码的标记清除。输入带区号的座机号码即可操作。',
      },
    },
    {
      '@type': 'Question',
      name: '号码标记清除要多久？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '标记清除服务与中国信通院码号服务推进组通常1-3个工作日完成处理,Truecaller提交取消收录后24-48小时移除。整体清除通过多个渠道配合,一般1周内可彻底清除。',
      },
    },
    {
      '@type': 'Question',
      name: '号码被标记骚扰电话怎么解除？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '号码被标记为骚扰电话后,可通过本站标记清除服务入口操作,支持手机号与座机号;同时到中国信通院码号服务推进组(opene164.org.cn)清除;若号码有海外标记,再到Truecaller取消收录。多渠道配合可彻底清除。',
      },
    },
    {
      '@type': 'Question',
      name: '号码标记清除收费吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '本站标记清除服务查询免费,中国信通院码号服务推进组与Truecaller的查询和取消收录也均为免费。',
      },
    },
  ],
};
---
<BaseLayout
  title="号码标记清除 - 手机号/座机号误标记清除服务 | 号码通查"
  description="号码标记清除服务,手机号码与座机(固话)号码均支持。提供标记清除服务入口,聚合中国信通院码号服务推进组(opene164.org.cn)与Truecaller官方清除入口,一站式解决号码被误标记为骚扰电话的问题。"
  schema={[howToSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- AI 摘要: 前150字结论前置 -->
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码标记清除 — 手机号 / 座机号均可处理</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    号码标记清除是指解除手机号码或座机(固话)号码被各平台误标记为骚扰电话、诈骗电话、推销电话的过程。本站提供标记清除服务入口,<strong>手机号码与座机号码均支持</strong>;同时聚合中国信息通信研究院码号服务推进组(opene164.org.cn,国内唯一官方跨平台清除入口)与Truecaller官方清除入口。多渠道配合,可彻底清除误标记,查询免费。
  </p>

  <!-- 核心清除入口 -->
  <section class="mb-8">
    <div class="bg-gradient-to-br from-brand-600 to-brand-700 rounded-2xl p-8 text-white text-center shadow-lg">
      <h2 class="text-2xl font-bold mb-2">标记清除 — 手机号 / 座机号</h2>
      <p class="text-brand-100 mb-6">输入手机号码或座机号码,查询并清除误标记</p>
      <a href={serviceUrl} target="_blank" rel="noopener" class="inline-block px-8 py-4 bg-white text-brand-700 rounded-xl font-bold text-lg hover:bg-brand-50 transition-colors shadow-md">
        立即清除标记 →
      </a>
      <p class="text-brand-200 text-sm mt-4">支持手机号 · 座机号</p>
    </div>
  </section>

  <!-- 服务保障 -->
  <section class="mb-8 bg-white rounded-xl p-6 border border-slate-200">
    <h2 class="text-xl font-bold text-slate-800 mb-4">服务保障</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">手机号与座机号均支持</h3>
          <p class="text-xs text-slate-500 mt-1">无论个人手机号还是企业座机(固话)号码,均可查询并清除误标记。</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">不存储您的号码</h3>
          <p class="text-xs text-slate-500 mt-1">本站不存储您输入的号码,查询与清除在合作方服务页面完成。<a href="/privacy" class="text-brand-600 hover:underline">隐私政策</a></p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">授权合作方服务</h3>
          <p class="text-xs text-slate-500 mt-1">标记清除服务由授权合作方提供,本站提供入口导航,来源透明。</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">多渠道彻底清除</h3>
          <p class="text-xs text-slate-500 mt-1">合作方服务 + 信通院 + Truecaller 三渠道配合,覆盖国内与国际标记。</p>
        </div>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-sm">
      <span class="text-slate-500">遇到问题? <a href="/contact" class="text-brand-600 hover:underline">联系我们</a></span>
      <span class="text-slate-500">查看 <a href="/faq" class="text-brand-600 hover:underline">常见问题</a></span>
    </div>
  </section>

  <!-- 清除入口表格 -->
  <section class="prose-content mb-8">
    <h2>号码标记清除入口一览</h2>
    <p>
      下表汇总了可用的号码标记清除渠道。<strong>标记清除服务</strong>支持手机号与座机号,推荐优先使用;<strong>中国信通院码号服务推进组</strong>是国内唯一官方跨平台清除入口;Truecaller适合清除海外标记。
    </p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>清除渠道</th>
            <th>类型</th>
            <th>清除入口</th>
            <th>支持号码</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((p) => (
            <tr>
              <td><strong>{p.name}</strong></td>
              <td>{p.type}</td>
              <td>
                {p.appealUrl && isUrl(p.appealUrl) ? (
                  <a href={p.appealUrl} target="_blank" rel="noopener nofollow">点击清除</a>
                ) : (
                  <span>{p.note}</span>
                )}
              </td>
              <td>手机号 / 座机号</td>
              <td>{p.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 各渠道清除说明 -->
  <section class="prose-content mb-8">
    <h2>各渠道清除操作说明</h2>

    <h3>1. 标记清除服务(推荐优先)</h3>
    <p>
      点击上方"立即清除标记"按钮进入清除服务,输入您的<strong>手机号码或座机号码</strong>,查询标记情况后可直接发起清除。手机号与座机号均支持,操作便捷。这是最高效的清除方式,推荐优先使用。
    </p>

    <h3>2. 中国信通院码号服务推进组</h3>
    <p>
      访问 <a href="http://www.opene164.org.cn" target="_blank" rel="noopener nofollow">opene164.org.cn</a>,该平台是国内<strong>唯一官方跨平台号码标记清除入口</strong>。支持手机号码、座机(固话)号码查询;<strong>中国联通手机号可一站式清除</strong>误标记——提交申诉后由信通院协调各平台统一处理。移动、电信号建议配合标记清除服务使用。流程:进入网站 → 号码误标记处置 → 输入号码与机主信息 → 提交申诉 → 等待审核。完全免费。
    </p>

    <h3>3. Truecaller(海外标记清除)</h3>
    <p>
      访问 <a href="https://www.truecaller.com/unlisting" target="_blank" rel="noopener nofollow">truecaller.com/unlisting</a>,输入带国家码的号码(如 +8613xxxxxxxxx)与验证码,提交取消收录申请。通常 <strong>24-48小时内移除</strong>。若号码被海外用户标记,需在此单独申诉清除。
    </p>
  </section>

  <!-- 清除通用要点 -->
  <section class="prose-content mb-8">
    <h2>清除通用要点</h2>
    <ul>
      <li><strong>手机号与座机号均支持:</strong>本站标记清除服务与信通院均支持手机号码与座机(固话)号码的标记清除,座机号需输入区号。</li>
      <li><strong>多渠道配合更彻底:</strong>标记清除服务、信通院、Truecaller三个渠道配合使用,可覆盖国内与国际标记,清除更彻底。</li>
      <li><strong>审核周期1-3个工作日:</strong>标记清除服务与信通院通常1-3个工作日完成处理,Truecaller 24-48小时移除。</li>
      <li><strong>号码回收可能继承标记:</strong>号码回收再发放后可能继承前机主的标记,新办的号也可能被误标,需清除。</li>
      <li><strong>清除后建议复查:</strong>清除完成后,可前往<a href="/tools/marking-check">号码标记自查</a>页面复查确认标记已清除。</li>
    </ul>
  </section>

  <!-- 清除流程 -->
  <section class="prose-content mb-8">
    <h2>号码标记清除完整流程</h2>
    <ol class="list-decimal list-inside mb-4 text-slate-600 space-y-2">
      <li>
        <strong>第一步:使用标记清除服务。</strong>点击本页清除入口,输入手机号或座机号,查询并清除误标记。
      </li>
      <li>
        <strong>第二步:到信通院官方清除。</strong>访问 opene164.org.cn,联通号可一站式清除;移动/电信号补充处理。
      </li>
      <li>
        <strong>第三步:Truecaller取消收录(如需)。</strong>号码有国际往来时,到 truecaller.com/unlisting 取消收录。
      </li>
      <li>
        <strong>第四步:等待并复查。</strong>等待1-3个工作日处理完成,再到<a href="/tools/marking-check">标记自查</a>页面复查确认。
      </li>
    </ol>
    <blockquote>
      提示:若不确定号码被哪些平台标记,可先前往<a href="/tools/marking-check">号码标记自查</a>页面查询标记情况,再有针对性地清除。
    </blockquote>
  </section>

  <!-- 数据来源声明 -->
  <section class="bg-slate-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-slate-800 mb-2">数据来源</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      本页清除渠道包括:标记清除服务(支持手机号与座机号)、中国信通院码号服务推进组(opene164.org.cn,官方跨平台清除入口)、Truecaller(truecaller.com,全球来电识别)。本站不存储用户提交的任何信息,所有清除操作在各渠道服务页面完成。
    </p>
  </section>
</BaseLayout>
