---
// 号码标记清除 - 各平台官方申诉入口与教程
import BaseLayout from '@layouts/BaseLayout.astro';
import platformsData from '@data/platforms.json';

const platforms = platformsData.platforms;

// 判断字符串是否为 URL(用于区分申诉直链与操作说明)
const isUrl = (s: string) => /^https?:\/\//.test(s);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码标记清除', url: '/tools/marking-clear' },
];

// HowTo 结构化数据: 如何清除号码标记
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '如何清除号码标记',
  description: '通过各平台官方申诉渠道清除手机号被误标记为骚扰/诈骗电话的完整流程,含信通院一站式清除与分平台申诉教程。',
  totalTime: 'PT15M',
  step: [
    {
      '@type': 'HowToStep',
      name: '步骤一: 优先通过中国信通院码号服务推进组清除',
      text: '访问 opene164.org.cn,中国联通手机号及400号可在此一站式清除误标记。这是国内唯一官方跨平台清除入口,联通号提交申诉后由信通院协调各平台统一处理。',
      url: 'http://www.opene164.org.cn',
    },
    {
      '@type': 'HowToStep',
      name: '步骤二: 逐一到各平台官方申诉入口提交',
      text: '由于各平台标记数据相互独立,需逐一申诉。依次前往360号码申诉(haomashensu.360.cn/question.html)、腾讯号码公众平台(yun.m.qq.com)、百度号码认证(haoma.baidu.com)、泰迪熊移动(teddymobile.cn/numberComplaint)、电话邦(dianhua.cn/appeal)、搜狗号码通(邮件 IMETS@tencent.com)、Truecaller(truecaller.com/unlisting)提交申诉。',
    },
    {
      '@type': 'HowToStep',
      name: '步骤三: 准备申诉材料并提交',
      text: '申诉时需详述机主身份信息(个人号码提供机主姓名,企业号码提供企业名称)、附上错误标记截图。标记超过20人的号码需提供号码归属证明:个人号码提供机主身份证,企业号码提供营业执照。提交后等待各平台审核。',
    },
    {
      '@type': 'HowToStep',
      name: '步骤四: 等待审核结果',
      text: '各平台审核周期通常为1-3个工作日,审核结果多以短信通知。审核通过后标记清除,部分平台可能需刷新缓存。若某平台未通过,可补充材料重新申诉。华为等终端的标记需到数据源头(腾讯/泰迪熊/电话邦)申诉才能根治。',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '号码标记清除要多久？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '各平台审核周期通常为1-3个工作日,审核结果多以短信通知。Truecaller可在提交取消收录申请后24-48小时内移除。整体清除需逐平台进行,全部完成一般需1周左右。',
      },
    },
    {
      '@type': 'Question',
      name: '号码标记超过20人怎么清除？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '标记超过20人的号码,各平台通常要求提供号码归属证明:个人号码提供机主身份证,企业号码提供营业执照。提交证明后申诉通过率显著提高。建议同时附上错误标记截图与机主身份说明。',
      },
    },
    {
      '@type': 'Question',
      name: '华为号码标记怎么清除？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '华为终端可在电话App-骚扰拦截-号码申诉提交,但华为标记数据多来自腾讯、泰迪熊、电话邦等第三方库,根治需到这些数据源头平台申诉。建议同时向腾讯手机管家和泰迪熊移动提交申诉,从源头清除标记。',
      },
    },
    {
      '@type': 'Question',
      name: '搜狗号码通怎么取消标记？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '搜狗号码通现归腾讯系,申诉需发送邮件至 IMETS@tencent.com,邮件中写明被标记号码、机主信息、错误标记情况及联系方式。客服电话 0515-69189017。',
      },
    },
  ],
};
---
<BaseLayout
  title="号码标记清除 - 各平台官方申诉入口与教程 | 号码通查"
  description="号码标记清除指南:各平台官方申诉入口表格(360/腾讯/百度/华为/泰迪熊/电话邦/搜狗/Truecaller)与分平台图文教程。优先通过中国信通院码号服务推进组(opene164.org.cn)清除,联通号可一站式清除,通常1-3个工作日审核完成。"
  schema={[howToSchema, faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- AI 摘要: 前150字结论前置(GEO 核心) -->
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码标记清除 — 各平台官方申诉入口与教程</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    号码标记清除需到各标记平台官方渠道提交申诉,推荐优先通过中国信通院码号服务推进组(opene164.org.cn)清除(联通号可一站式清除),再依次到360/腾讯/百度/华为等平台申诉,通常1-3个工作日审核完成。各平台标记数据相互独立,需逐一申诉才能彻底清除。本页汇总全部主流平台官方申诉入口、客服电话与分平台操作教程,所有入口均来自官方渠道,免费申诉。
  </p>

  <!-- 申诉入口表格 -->
  <section class="prose-content mb-8">
    <h2>各平台号码标记申诉入口一览</h2>
    <p>
      下表汇总了国内全部主流号码标记平台的官方申诉入口、客服电话与备注信息。<strong>中国信通院码号服务推进组</strong>是国内唯一官方跨平台清除入口,中国联通手机号及400号可一站式清除,推荐优先使用。其余平台需逐一申诉。
    </p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>平台</th>
            <th>申诉入口</th>
            <th>客服电话</th>
            <th>备注</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((p) => (
            <tr>
              <td><strong>{p.name}</strong></td>
              <td>
                {p.appealUrl && isUrl(p.appealUrl) ? (
                  <a href={p.appealUrl} target="_blank" rel="noopener nofollow">{p.appealUrl}</a>
                ) : (
                  <span>{p.appealUrl || '见备注'}</span>
                )}
              </td>
              <td>{p.phone || '—'}</td>
              <td>{p.note || p.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 通用申诉要点 -->
  <section class="prose-content mb-8">
    <h2>申诉通用要点</h2>
    <p>无论在哪个平台申诉,以下要点均需注意,可显著提高申诉通过率:</p>
    <ul>
      <li><strong>详述机主身份:</strong>个人号码需提供机主姓名及身份信息,企业号码需提供企业全称。这是证明号码归属的基础。</li>
      <li><strong>附错误标记截图:</strong>提供显示错误标记的截图(如来电界面显示"骚扰电话"的截图),作为误标证据。</li>
      <li><strong>各平台数据独立需逐一申诉:</strong>360、腾讯、百度等平台标记数据互不同步,在A平台清除不会自动清除B平台,必须逐一申诉。</li>
      <li><strong>审核周期1-3个工作日:</strong>各平台审核通常1-3个工作日,结果多以短信通知。Truecaller提交取消收录后24-48小时移除。</li>
      <li><strong>标记超20人需提供号码证明:</strong>标记人数超过20的号码,各平台通常要求提供号码归属证明——个人号码提供机主身份证,企业号码提供营业执照。提交证明后通过率显著提高。</li>
      <li><strong>华为等终端需到源头申诉:</strong>华为、OPPO、vivo、小米等终端的标记数据多来自腾讯、泰迪熊、电话邦等第三方库,仅在终端申诉无法根治,需到数据源头平台申诉。</li>
    </ul>
  </section>

  <!-- 分平台清除教程 -->
  <section class="prose-content mb-8">
    <h2>分平台清除教程</h2>

    <h3>1. 中国信通院码号服务推进组(最优先)</h3>
    <p>
      访问 <a href="http://www.opene164.org.cn" target="_blank" rel="noopener nofollow">opene164.org.cn</a>,该平台是国内唯一官方跨平台号码标记清除入口。<strong>中国联通手机号及400号可一站式清除</strong>误标记——提交申诉后由信通院协调各平台统一处理,无需逐个平台申诉。移动、电信号暂需到各平台分别申诉。流程:进入网站 → 号码误标记处置 → 输入号码与机主信息 → 提交申诉 → 等待审核。完全免费。
    </p>

    <h3>2. 360 手机卫士</h3>
    <p>
      访问 <a href="http://haomashensu.360.cn/question.html" target="_blank" rel="noopener nofollow">haomashensu.360.cn/question.html</a>,输入被标记号码,选择错误标记类型(骚扰/诈骗/推销等),提交机主信息及错误标记截图。审核约1-3个工作日,结果短信通知。客服电话 010-89180702。标记超过20人的号码需提供机主身份证(个人)或营业执照(企业)。
    </p>

    <h3>3. 腾讯手机管家</h3>
    <p>
      访问 <a href="https://yun.m.qq.com/content.html#1" target="_blank" rel="noopener nofollow">yun.m.qq.com</a>,腾讯号码公众平台可提交号码申诉。个人号码提供机主信息与误标截图;企业号码建议注册号码公众平台,认证后可自行管理号码展示名称,从源头避免误标。客服电话 0755-83765566。注意腾讯通常6人以上标记才展示,未展示的标记无需申诉。
    </p>

    <h3>4. 百度号码认证</h3>
    <p>
      访问 <a href="https://haoma.baidu.com" target="_blank" rel="noopener nofollow">haoma.baidu.com</a>,提交号码申诉。企业号码可申请号码认证(绿标),认证后来电显示企业名称,有效避免被误标为骚扰。如遇申诉问题可加入官方QQ群 910251361 获取协助。
    </p>

    <h3>5. 华为终端</h3>
    <p>
      在华为手机上操作:<strong>电话App → 骚扰拦截 → 号码申诉</strong>。但需注意,华为标记数据多来自腾讯、泰迪熊移动、电话邦等第三方库,仅在华为终端申诉无法根治。建议同时向腾讯手机管家(yun.m.qq.com)、泰迪熊移动(teddymobile.cn/numberComplaint,客服 400-825-3666)、电话邦(dianhua.cn/appeal,客服 400-061-8800)提交申诉,从数据源头清除。
    </p>

    <h3>6. 搜狗号码通</h3>
    <p>
      搜狗号码通现归腾讯系,无网页申诉入口。需发送邮件至 <a href="mailto:IMETS@tencent.com">IMETS@tencent.com</a>,邮件中写明:被标记号码、机主信息(个人提供姓名,企业提供企业名称)、错误标记情况(标记类型与截图)、联系方式。客服电话 0515-69189017。审核通过后标记清除。
    </p>

    <h3>7. Truecaller(海外)</h3>
    <p>
      访问 <a href="https://www.truecaller.com/unlisting" target="_blank" rel="noopener nofollow">truecaller.com/unlisting</a>,输入带国家码的号码(如 +8613xxxxxxxxx)与验证码,提交取消收录申请。通常 <strong>24-48小时内移除</strong>。若号码被海外用户标记,需在此单独申诉。
    </p>

    <h3>8. OPPO / vivo / 小米</h3>
    <p>
      各终端操作路径:<strong>设置 → 安全中心 → 号码申诉</strong>(部分机型为"手机管家 → 骚扰拦截 → 号码申诉")。与华为类似,这些终端的标记数据多来自腾讯、泰迪熊、电话邦等第三方库,需到数据源头平台申诉才能彻底清除。
    </p>
  </section>

  <!-- 清除流程 -->
  <section class="prose-content mb-8">
    <h2>号码标记清除完整流程</h2>
    <ol class="list-decimal list-inside mb-4 text-slate-600 space-y-2">
      <li>
        <strong>优先通过信通院清除:</strong>访问 opene164.org.cn,联通号可一站式清除;移动/电信号继续下一步逐一申诉。
      </li>
      <li>
        <strong>逐一到各平台申诉入口提交:</strong>依次前往360、腾讯、百度、泰迪熊、电话邦、搜狗、Truecaller 提交申诉,各平台数据独立不可遗漏。
      </li>
      <li>
        <strong>准备并提交申诉材料:</strong>详述机主身份,附错误标记截图;标记超20人需提供号码归属证明(身份证/营业执照)。
      </li>
      <li>
        <strong>等待审核结果:</strong>各平台1-3个工作日审核,短信通知结果。华为等终端标记需到数据源头(腾讯/泰迪熊/电话邦)申诉根治。
      </li>
    </ol>
    <blockquote>
      提示:若不确定号码被哪些平台标记,可先前往<a href="/tools/marking-check">号码标记自查</a>页面查询各平台标记情况,再有针对性地申诉。
    </blockquote>
  </section>

  <!-- 数据来源声明 -->
  <section class="bg-slate-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-slate-800 mb-2">数据来源</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      本页申诉入口信息均来自各平台官方渠道:中国信通院码号服务推进组(opene164.org.cn)、360号码申诉平台(haomashensu.360.cn)、腾讯号码公众平台(yun.m.qq.com)、百度号码认证(haoma.baidu.com)、泰迪熊移动(teddymobile.cn)、电话邦(dianhua.cn)、搜狗号码通(IMETS@tencent.com)、Truecaller(truecaller.com)。华为终端申诉入口参考华为消费者业务官方说明。号码通查不直接提供标记清除服务,而是聚合各平台官方申诉入口与教程,引导用户到官方平台免费申诉,不存储用户提交的任何信息。
    </p>
  </section>
</BaseLayout>
