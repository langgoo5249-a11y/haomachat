---
// 号码标记清除 - 标记清除服务入口与官方平台
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolFaq from '@components/ToolFaq.astro';
import ToolScenarios from '@components/ToolScenarios.astro';
import ToolComparison from '@components/ToolComparison.astro';
import ToolFacts from '@components/ToolFacts.astro';
import platformsData from '@data/platforms.json';

const platforms = platformsData.platforms;

const isUrl = (s: string) => /^https?:\/\//.test(s);

// 公司服务链接
// ⛔ 死规定：此链接为合作方真实服务地址，永远不得修改、替换或移除。
const serviceUrl = 'https://xbh5.open10086.com/#/?authorization=f91029a83a8758aa';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码标记清除', url: '/tools/marking-clear' },
];

const pageUpdated = '2026-09-28';

const toolWebAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '号码标记清除工具',
  description: '聚合360、腾讯、百度、华为、泰迪熊、电话邦六大平台及信通院的号码标记清除入口，支持手机号与座机号标记申诉。',
  url: 'https://zangxixitech.cn/tools/marking-clear/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  provider: { '@type': 'Organization', name: '号码通查', url: 'https://zangxixitech.cn' },
  featureList: '360标记清除,腾讯标记清除,百度标记清除,华为标记清除,泰迪熊标记清除,电话邦标记清除,信通院跨平台清除',
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '如何清除号码标记',
  description: '清除手机号码与座机号码被误标记为骚扰/推销电话的完整流程,支持手机号与固话。诈骗类标记不在清除范围。',
  totalTime: 'PT10M',
  step: [
    {
      '@type': 'HowToStep',
      name: '步骤一: 进入标记清除服务',
      text: '点击本页标记清除入口,输入您的手机号码或座机(固话)号码,系统将查询并支持清除误标记。手机号与座机号均支持,推荐优先使用。',
      url: serviceUrl,
    },
    {
      '@type': 'HowToStep',
      name: '步骤二: 到中国信通院码号服务推进组清除',
      text: '访问 opene164.org.cn,这是国内唯一官方跨平台号码标记清除入口。支持手机号与座机号查询;中国联通手机号可一站式清除误标记。',
      url: 'https://www.opene164.org.cn',
    },
    {
      '@type': 'HowToStep',
      name: '步骤三: Truecaller取消收录(海外标记)',
      text: '若号码有国际往来,访问 truecaller.com/unlisting,输入带国家码的号码与验证码,提交取消收录申请,通常24-48小时内移除。',
      url: 'https://www.truecaller.com/unlisting',
    },
    {
      '@type': 'HowToStep',
      name: '步骤四: 等待处理结果',
      text: '各渠道处理时间不同:标记清除服务与信通院通常1-3个工作日,Truecaller 24-48小时。处理完成后标记清除,来电不再显示错误标签。',
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '号码标记清除服务',
  description: '支持手机号码与座机(固话)号码的标记查询与清除,一站式处理误标记为骚扰电话、推销电话的问题。',
  url: 'https://zangxixitech.cn/tools/marking-clear/',
  serviceType: '号码标记清除',
  provider: { '@id': 'https://zangxixitech.cn/#organization' },
  areaServed: { '@type': 'Country', name: 'CN' },
  availableChannel: [
    { '@type': 'ServiceChannel', serviceUrl: serviceUrl, name: '在线清除入口' },
    { '@type': 'ServiceChannel', serviceUrl: 'https://www.opene164.org.cn', name: '中国信通院码号服务推进组' },
    { '@type': 'ServiceChannel', serviceUrl: 'https://www.truecaller.com/unlisting', name: 'Truecaller取消列入' },
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY', availability: 'https://schema.org/InStock' },
  category: '号码服务',
  dateModified: pageUpdated,
};

// FAQ 单一数据源: 同时用于可见区块与 FAQPage 结构化数据, 保证两者一致
const faqs = [
  {
    q: '座机号码能清除标记吗？',
    a: '可以。号码通查的标记清除服务与中国信通院码号服务推进组均支持座机(固话)号码的标记清除,输入带区号的座机号码即可操作。企业总机、400 客服号被标记也适用同一流程。',
  },
  {
    q: '号码标记清除要多久？',
    a: '分渠道不同。合作方标记清除服务与中国信通院码号服务推进组通常 1-3 个工作日完成处理;Truecaller 提交取消收录后 24-48 小时移除。若号码同时被多个平台标记,建议多渠道配合,整体一般 1 周内可以清干净。',
  },
  {
    q: '号码被标记骚扰电话怎么解除？',
    a: '一共三步。第一步先用本站标记清除入口提交申诉,支持手机号与座机号;第二步到中国信通院码号服务推进组(opene164.org.cn)做官方跨平台申诉,中国联通手机号可一站式清除;第三步,若号码有海外标记,再到 Truecaller 取消收录。三部完成后回到标记自查页复查确认。',
  },
  {
    q: '号码标记清除收费吗？需要提交什么材料？',
    a: '查询与官方渠道申诉均免费。材料方面,一般只需要号码本身;通过中国信通院申诉时会要求填写机主信息用于比对,不需要额外上传证件照片。号码通查本身不存储您提交的号码,信通院渠道的信息由其按官方流程留存,我们不经手。',
  },
  {
    q: '哪些标记是清除不了的？',
    a: '诈骗类标记不在清除范围内。诈骗标记属于违法号码标记,由运营商与公安机关管理,不能通过申诉清除。此外,如果标记只存在于手机厂商的本地拦截库(部分机型自带的识别库),跨平台申诉入口可能不生效,需要在手机端单独处理。',
  },
  {
    q: '清除后会反弹吗？怎么防止再被标记？',
    a: '会反弹,高频外呼号码尤其明显。清除只是删除了当前的标记数据,如果号码继续被大量用户标记或拦截,平台会重新打标。防反弹通常做三件事:控制外呼频次与时段,给企业号码办理号码认证(来电显示公司名与绿标),以及定期自查标记状态。',
  },
  {
    q: '清除后怎么确认已经清干净了？',
    a: '两个动作。一是回到号码标记自查页面重新查询,确认各平台的标记已经消失;二是用另一台手机拨打自己的号码,看来电界面是否还显示"骚扰""推销"等标签。两个结果都正常,才算清除彻底。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  datePublished: '2026-07-06',
  dateModified: pageUpdated,
  inLanguage: 'zh-CN',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 可核验数据(替代用户证言, 仅陈述可验证事实)
const facts = [
  { num: '6', unit: '大平台可申诉', desc: '360/腾讯/百度/华为/泰迪熊/电话邦' },
  { num: '3', unit: '大清除渠道', desc: '清除服务+信通院+Truecaller' },
  { num: '1-3', unit: '个工作日', desc: '官方渠道处理周期' },
  { num: '24-48', unit: '小时', desc: 'Truecaller 取消收录时效' },
];

// 场景卡矩阵: 每卡对应一个可搜索的长尾场景
const scenarios = [
  { title: '手机号被误标骚扰/推销', desc: '个人号码被标后影响日常通话,判断与申诉路径', href: '/blog/2026-personal-number-marking-removal-guide/' },
  { title: '座机/固话被标记', desc: '企业总机被标,客户拨打时显示骚扰标签', href: '/guide/landline-marking-clear/' },
  { title: '企业 400 号码被标记', desc: '400 客服号被标,客户接听率下降', href: '/blog/2026-enterprise-400-number-marking-clear-guide/' },
  { title: '95/96 号码被标记', desc: '企业客服号段被标记的分渠道处置', href: '/blog/2026-enterprise-95-96-number-marking-clear-guide/' },
  { title: '二次放号带旧标记', desc: '新办号码继承前机主标记,申诉清除流程', href: '/blog/2026-recycled-number-false-marking-guide/' },
  { title: '被标成"中介""贷款"', desc: '细分标签的申诉材料与话术', href: '/blog/2026-number-labeled-intermediary-realestate-loan-guide/' },
  { title: '申诉被驳回了', desc: '六大平台驳回原因对照与二次申诉', href: '/blog/2026-number-marking-appeal-rejected-solutions/' },
  { title: '标记清了又反弹', desc: '防回流机制与定期自查节奏', href: '/blog/2026-phone-marking-recurrence-after-clearance/' },
  { title: '销售外呼号反复被标', desc: '高频外呼场景的防标记与清除组合方案', href: '/blog/2026-high-frequency-outbound-number-marking-solution/' },
];

const comparisonRows = [
  { dim: '需要几个申诉入口', old: '360/腾讯/百度/华为等 6+ 平台逐个申诉', ours: '1 个入口 + 信通院官方跨平台申诉' },
  { dim: '材料准备', old: '各平台要求不同,同一套材料反复提交', ours: '按清单一次备齐,后续复用' },
  { dim: '处理周期', old: '逐个平台排队,整体周期更长', ours: '官方渠道 1-3 个工作日' },
  { dim: '被驳回之后', old: '需自己判断原因再试一次', ours: '提供六大平台驳回原因对照与二次申诉指引' },
  { dim: '座机号支持', old: '部分平台不开放固话申诉', ours: '手机号与座机号均支持' },
  { dim: '海外标记', old: '一般不在处理范围内', ours: '附 Truecaller 取消收录入口' },
];
---
<BaseLayout
  title="2026最新号码标记清除：手机/座机误标记免费申诉教程 | 号码通查"
  description="手机号/座机被误标骚扰、推销、诈骗？号码通查聚合信通院与Truecaller官方清除入口，提供分步申诉教程，1-3个工作日清除误标记，查询免费，不存储号码。"
  schema={[howToSchema, faqSchema, toolWebAppSchema, serviceSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- AI 摘要: 前150字结论前置 -->
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码标记清除 — 手机号 / 座机号均可处理</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    号码标记清除是指解除手机号码或座机(固话)号码被各平台误标记为骚扰电话、推销电话的过程。本站提供标记清除服务入口,<strong>手机号码与座机号码均支持</strong>;同时聚合中国信息通信研究院码号服务推进组(opene164.org.cn,国内唯一官方跨平台清除入口)与Truecaller官方清除入口。多渠道配合,可彻底清除误标记,查询免费。<strong>注:诈骗类标记不在清除范围内,诈骗标记属于违法号码标记,无法通过申诉清除。</strong>
  </p>

  <!-- 核心清除入口 -->
  <section class="mb-8">
    <div class="card border-l-4 border-l-brand-600 p-6 flex flex-col md:flex-row items-center gap-6">
      <div class="w-12 h-12 rounded-lg bg-brand-50 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <div class="flex-1 text-center md:text-left">
        <h2 class="text-lg font-bold text-slate-800">号码标记清除 — 手机号 / 座机号</h2>
        <p class="text-sm text-slate-500 mt-1">输入手机号码或座机号码,查询并清除误标记</p>
      </div>
      <a href={serviceUrl} target="_blank" rel="noopener" class="px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 whitespace-nowrap transition-colors">立即清除标记 →</a>
    </div>
  </section>

  <!-- 可核验数据 -->
  <ToolFacts facts={facts} />

  <!-- 服务保障 -->
  <section class="mb-8 bg-white rounded-xl p-6 border border-slate-200">
    <h2 class="text-xl font-bold text-slate-800 mb-4">服务保障</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">手机号与座机号均支持</h3>
          <p class="text-xs text-slate-500 mt-1">无论个人手机号还是企业座机(固话)号码,均可查询并清除误标记。</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">不存储您的号码</h3>
          <p class="text-xs text-slate-500 mt-1">本站不存储您输入的号码,查询与清除在合作方服务页面完成。<a href="/privacy" class="text-brand-600 hover:underline">隐私政策</a></p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">授权合作方服务</h3>
          <p class="text-xs text-slate-500 mt-1">标记清除服务由授权合作方提供,本站提供入口导航,来源透明。</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <div>
          <h3 class="font-semibold text-slate-700 text-sm">多渠道彻底清除</h3>
          <p class="text-xs text-slate-500 mt-1">合作方服务 + 信通院 + Truecaller 三渠道配合,覆盖国内与国际标记。</p>
        </div>
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-sm">
      <span class="text-slate-500">遇到问题? <a href="/contact" class="text-brand-600 hover:underline">联系我们</a></span>
      <span class="text-slate-500">查看 <a href="/faq" class="text-brand-600 hover:underline">常见问题</a></span>
    </div>
  </section>

  <!-- 清除入口表格 -->
  <section class="prose-content mb-8">
    <h2>号码标记清除入口一览</h2>
    <p>
      下表汇总了可用的号码标记清除渠道。<strong>标记清除服务</strong>支持手机号与座机号,推荐优先使用;<strong>中国信通院码号服务推进组</strong>是国内唯一官方跨平台清除入口;Truecaller适合清除海外标记。
    </p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>清除渠道</th>
            <th>类型</th>
            <th>清除入口</th>
            <th>支持号码</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((p) => (
            <tr>
              <td><strong>{p.name}</strong></td>
              <td>{p.type}</td>
              <td>
                {p.appealUrl && isUrl(p.appealUrl) ? (
                  <a href={p.appealUrl} target="_blank" rel="noopener nofollow">点击清除</a>
                ) : (
                  <span>{p.note}</span>
                )}
              </td>
              <td>手机号 / 座机号</td>
              <td>{p.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 各渠道清除说明 -->
  <section class="prose-content mb-8">
    <h2>各渠道清除操作说明</h2>

    <h3>1. 标记清除服务(推荐优先)</h3>
    <p>
      点击上方"立即清除标记"按钮进入清除服务,输入您的<strong>手机号码或座机号码</strong>,查询标记情况后可直接发起清除。手机号与座机号均支持,操作便捷。这是最高效的清除方式,推荐优先使用。
    </p>

    <h3>2. 中国信通院码号服务推进组</h3>
    <p>
      访问 <a href="https://www.opene164.org.cn" target="_blank" rel="noopener nofollow">opene164.org.cn</a>,该平台是国内<strong>唯一官方跨平台号码标记清除入口</strong>。支持手机号码、座机(固话)号码查询;<strong>中国联通手机号可一站式清除</strong>误标记——提交申诉后由信通院协调各平台统一处理。移动、电信号建议配合标记清除服务使用。流程:进入网站 → 号码误标记处置 → 输入号码与机主信息 → 提交申诉 → 等待审核。完全免费。
    </p>

    <h3>3. Truecaller(海外标记清除)</h3>
    <p>
      访问 <a href="https://www.truecaller.com/unlisting" target="_blank" rel="noopener nofollow">truecaller.com/unlisting</a>,输入带国家码的号码(如 +8613xxxxxxxxx)与验证码,提交取消收录申请。通常 <strong>24-48小时内移除</strong>。若号码被海外用户标记,需在此单独申诉清除。
    </p>
  </section>

  <!-- 场景卡矩阵 -->
  <ToolScenarios
    title="按场景找到你的清除路径"
    intro="不同类型号码的申诉渠道与材料不同。找到最接近你情况的一项,直接看对应流程。"
    scenarios={scenarios}
  />

  <!-- 方案对比 -->
  <ToolComparison
    title="方案对比: 逐个平台申诉 vs 一站式清除"
