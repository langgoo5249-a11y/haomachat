---
// 号码归属地查询工具页 - 真实可用, 含交互
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolFaq from '@components/ToolFaq.astro';
import ToolScenarios from '@components/ToolScenarios.astro';
import ToolComparison from '@components/ToolComparison.astro';
import ToolFacts from '@components/ToolFacts.astro';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码归属地查询', url: '/tools/attribution' },
];

const pageUpdated = '2026-09-28';

const toolWebAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '手机号归属地查询工具',
  description: '查询手机号码归属地、运营商、号段信息，支持携号转网后归属地更新查询。',
  url: 'https://zangxixitech.cn/tools/attribution/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  provider: { '@type': 'Organization', name: '号码通查', url: 'https://zangxixitech.cn' },
  featureList: '归属地查询,运营商查询,号段查询,携号转网查询,座机归属地查询',
};

// FAQ 单一数据源: 同时用于可见区块与 FAQPage 结构化数据, 保证两者一致
const faqs = [
  {
    q: '如何查询手机号归属地？',
    a: '在上方输入框输入 11 位手机号码，点击"查询"即可获取归属省份、城市、运营商、号段等信息。数据来自 360 手机号码归属地接口，免费使用，无需注册。',
  },
  {
    q: '号码归属地查询收费吗？',
    a: '号码通查的归属地查询工具完全免费，无需注册，不限查询次数。号码通查本身不存储您输入的号码，查询在服务端完成。',
  },
  {
    q: '能查询固话归属地吗？',
    a: '支持。输入"区号+号码"（如 010-12345678）即可查询固定电话归属地，固话数据覆盖全国主要城市。',
  },
  {
    q: '携号转网后归属地会变吗？',
    a: '携号转网只改变运营商，不改变号码归属地。归属地由号码注册时的号段决定，转网后省份城市保持不变；但部分工具返回的"运营商"字段可能仍显示转网前信息，需以运营商官方为准。',
  },
  {
    q: '为什么查出的归属地和号码实际所在地不一样？',
    a: '归属地指号码注册时由号段决定的地域，不等于号码当前的实时所在地。异地使用、长期漫游的号码，归属地仍是注册地，这是正常现象，并非查询出错。',
  },
  {
    q: '查询结果准确吗？数据来自哪里？',
    a: '归属地数据来自 360 手机号码归属地接口，依据工信部分配的号段判断，准确率约 99%，覆盖全国 31 个省级行政区。个别新放号段可能存在短暂滞后，最终以运营商官方信息为准。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  datePublished: '2026-07-23',
  dateModified: pageUpdated,
  inLanguage: 'zh-CN',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 可核验数据(仅陈述可验证事实)
const facts = [
  { num: '31', unit: '省级行政区', desc: '覆盖全国手机号段与主要城市固话' },
  { num: '7', unit: '位号段判断', desc: '凭手机号前 7 位判断注册地运营商' },
  { num: '≈99%', unit: '数据准确率', desc: '数据来自 360 号码归属地接口' },
  { num: '0', unit: '存储 / 费用', desc: '不存储查询号码，查询免费' },
];

// 场景卡矩阵: 每卡对应一个可搜索的长尾场景
const scenarios = [
  { title: '陌生来电查归属地', desc: '查陌生号码的省份、城市与运营商', href: '/tools/attribution/' },
  { title: '归属地正常却被标记骚扰', desc: '归属地查完发现是骚扰号，转号码标记自查', href: '/tools/marking-check/' },
  { title: '携号转网后归属地是否变化', desc: '转网只换运营商，归属地不变，运营商字段可能滞后', href: '/blog/2026-phone-attribution-accuracy-after-mnp/' },
  { title: '企业客户号码核验', desc: '核验法人号码是否实名登记，走三要素核验', href: '/tools/legal-number-verify/' },
  { title: '归属地查询 API 对比', desc: '开发选型：各家归属地接口的能力与差异', href: '/compare/lookup-apis/' },
  { title: '查到误标记要清除', desc: '号码被错误标记后如何发起申诉清除', href: '/tools/marking-clear/' },
];

const comparisonRows = [
  { dim: '查询方式', old: '在搜索引擎里翻号段对照表', ours: '输入号码，一次返回省份/城市/运营商' },
  { dim: '号段覆盖', old: '老对照表常年不更新，新号段查不到', ours: '覆盖移动/联通/电信及虚拟运营商号段' },
  { dim: '固话支持', old: '多数在线工具不支持固话', ours: '手机号与带区号固话均可查' },
  { dim: '结果维度', old: '只有运营商，没有城市', ours: '省份、城市、运营商、区号、邮编' },
  { dim: '费用', old: '部分工具按次收费或弹窗引导', ours: '免费、无需注册、不限次数' },
  { dim: '隐私', old: '号码可能被留存在第三方', ours: '本站不存储查询号码' },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '查询手机号码归属地',
  description: '通过号码通查免费查询手机号码的归属地、运营商和号段信息',
  step: [
    { '@type': 'HowToStep', position: 1, name: '输入号码', text: '在查询框中输入11位手机号码或带区号的固定电话号码' },
    { '@type': 'HowToStep', position: 2, name: '点击查询', text: '点击"查询"按钮,系统将通过API获取号码信息' },
    { '@type': 'HowToStep', position: 3, name: '查看结果', text: '结果区域显示归属省份、城市、运营商、号段等信息' },
  ],
};
---
<BaseLayout
  title="手机号归属地查询免费版（2026）：3秒查运营商/城市/号段（含携号转网）| 号码通查"
  description="免费手机号归属地查询：输入11位号码3秒查出省份、城市、运营商、号段，支持携号转网后归属地更新。无需注册、不限次数，陌生号码一查便知。"
  schema={[faqSchema, howToSchema, toolWebAppSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码归属地查询</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    免费查询手机号码或固定电话的归属地信息,包括归属省份、城市、运营商、号段等。数据来自360手机号码归属地接口,覆盖全国移动/联通/电信手机号及主要城市固话。输入号码即可查询,无需注册,不限次数。
  </p>

  <!-- 可核验数据 -->
  <ToolFacts facts={facts} />

  <!-- 查询表单 (Island 交互, 使用原生 JS 最小化) -->
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm mb-8">
    <label for="phone-input" class="block text-sm font-medium text-slate-700 mb-2">输入手机号或固话</label>
    <div class="flex gap-3">
      <input
        id="phone-input"
        type="tel"
        placeholder="如: 13800138000 或 010-12345678"
        class="flex-1 px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-400 text-lg"
        autocomplete="off"
      />
      <button
        id="lookup-btn"
        class="px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 transition-colors whitespace-nowrap"
      >
        查询
      </button>
    </div>
    <p class="text-xs text-slate-400 mt-2">本站不存储您查询的号码。免费查询,无需注册。</p>
  </div>

  <!-- 结果区域 (JS 填充) -->
  <div id="result" class="hidden bg-white rounded-xl p-6 border border-slate-200 shadow-sm mb-8">
    <h2 class="text-lg font-bold text-slate-800 mb-4">查询结果</h2>
    <div id="result-content"></div>
  </div>

  <!-- 工具说明 (静态 HTML, AI 可读) -->
  <section class="prose-content mb-8">
    <h2>号码归属地查询说明</h2>
    <p>
      号码归属地查询是通过手机号码的前7位号段(又称MDN前缀)来判断号码注册时所属的省份、城市和运营商的技术。中国手机号段由工业和信息化部统一分配,移动、联通、电信各持有不同号段区间。本工具使用360手机号码归属地接口,数据准确率约99%,覆盖全国31个省级行政区。
    </p>

    <h3>支持查询的类型</h3>
    <ul>
      <li><strong>手机号码</strong>: 11位中国移动/联通/电信手机号,含虚拟运营商号段(170/171等)</li>
      <li><strong>固定电话</strong>: 带区号的固话号码,如010-XXXXXXXX</li>
      <li><strong>携号转网号码</strong>: 可查询原始运营商,携号转网后运营商信息可能不更新</li>
    </ul>

    <h3>常见手机号段分配</h3>
    <table>
      <thead>
        <tr><th>运营商</th><th>号段</th></tr>
      </thead>
      <tbody>
        <tr><td>中国移动</td><td>134-139, 147, 148, 150-152, 157-159, 172, 178, 182-184, 187, 188, 195, 197, 198</td></tr>
        <tr><td>中国联通</td><td>130-132, 145, 146, 155, 156, 166, 167, 171, 175, 176, 185, 186, 196</td></tr>
        <tr><td>中国电信</td><td>133, 149, 153, 173, 174, 177, 180, 181, 189, 190, 191, 193, 199</td></tr>
        <tr><td>虚拟运营商</td><td>170, 171(联通), 162(电信), 165(移动), 167(联通)等</td></tr>
      </tbody>
    </table>
  </section>

  <!-- 场景卡矩阵 -->
  <ToolScenarios
    title="按场景使用归属地查询"
    intro="不同场景查询重点不同，找到最接近你情况的一项。"
    scenarios={scenarios}
  />

  <!-- 方案对比 -->
  <ToolComparison
    title="方案对比: 翻号段对照表 vs 一站式查询"
    intro="自己对照号段表容易查到过期数据，尤其是新号段和虚拟运营商号段。"
    oldLabel="自己翻号段对照表"
    oursLabel="号码通查一站式查询"
    rows={comparisonRows}
  />

  <!-- 常见问题 -->
  <ToolFaq
    faqs={faqs}
    heading="号码归属地查询常见问题"
    intro="以下问题覆盖固话查询、携号转网、归属地与所在地不一致等情况。"
  />

  <p class="text-sm text-slate-500 mb-4">
    <a href="/tools/marking-check" class="text-brand-600 hover:underline">需要查询号码是否被标记? → 号码标记自查</a>
  </p>

  <!-- 交互脚本: 最小化 JS, 仅用于工具交互, 不影响静态内容可读性 -->
  <script is:inline>
    const input = document.getElementById('phone-input');
    const btn = document.getElementById('lookup-btn');
    const result = document.getElementById('result');
    const content = document.getElementById('result-content');

    async function lookup() {
      const phone = input.value.trim();
      if (!phone) { input.focus(); return; }
      btn.disabled = true;
      btn.textContent = '查询中...';
      content.innerHTML = '<p class="text-slate-500">正在查询,请稍候...</p>';
      result.classList.remove('hidden');

      try {
        const resp = await fetch('/api/attribution?phone=' + encodeURIComponent(phone));
        const data = await resp.json();
        if (data.ok) {
          if (data.source === 'local') {
            const fields = [];
            fields.push(`<p><span class="text-slate-500">号码:</span> <span class="font-mono">${data.phone}</span></p>`);
            if (data.company) fields.push(`<p><span class="text-slate-500">运营商:</span> <span class="font-medium">${data.company}</span></p>`);
            if (data.province) fields.push(`<p><span class="text-slate-500">省份:</span> <span class="font-medium">${data.province}</span></p>`);
            if (data.city) fields.push(`<p><span class="text-slate-500">城市:</span> <span class="font-medium">${data.city}</span></p>`);
            if (data.areacode) fields.push(`<p><span class="text-slate-500">区号:</span> <span class="font-medium">${data.areacode}</span></p>`);
            if (data.note) fields.push(`<div class="bg-amber-50 border border-amber-200 rounded p-3 text-sm text-amber-700">${data.note}</div>`);
            content.innerHTML = `<div class="space-y-2">${fields.join('')}</div>`;
          } else {
            content.innerHTML = `
              <div class="grid grid-cols-2 gap-3">
                <div><span class="text-slate-500 text-sm">号码</span><p class="font-mono font-medium">${data.phone}</p></div>
                <div><span class="text-slate-500 text-sm">运营商</span><p class="font-medium">${data.company || '—'}</p></div>
                <div><span class="text-slate-500 text-sm">省份</span><p class="font-medium">${data.province || '—'}</p></div>
                <div><span class="text-slate-500 text-sm">城市</span><p class="font-medium">${data.city || '—'}</p></div>
                <div><span class="text-slate-500 text-sm">区号</span><p class="font-medium">${data.areacode || '—'}</p></div>
                <div><span class="text-slate-500 text-sm">邮编</span><p class="font-medium">${data.zip || '—'}</p></div>
                <div><span class="text-slate-500 text-sm">卡类型</span><p class="font-medium">${data.card || '—'}</p></div>
              </div>`;
          }
        } else {
          content.innerHTML = `<div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">${data.error || '查询失败'}</div>`;
        }
      } catch (e) {
        content.innerHTML = '<div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">网络错误,请稍后重试</div>';
      }
      btn.disabled = false;
      btn.textContent = '查询';
    }
    btn.addEventListener('click', lookup);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') lookup(); });
  </script>

  <!-- 相关工具交叉链接 -->
  <nav class="mt-6 pt-6 border-t border-slate-200">
    <h2 class="text-lg font-bold text-slate-800 mb-3">相关工具与指南</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/marking-check/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">号码标记自查</a>
      <a href="/tools/marking-clear/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">号码标记清除</a>
      <a href="/tools/sim-cards/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">手机卡选号</a>
      <a href="/guide/sim-card-guide/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">手机卡指南</a>
      <a href="/blog/2026-phone-attribution-accuracy-after-mnp/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">携号转网归属地</a>
      <a href="/compare/lookup-apis/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">归属地API对比</a>
    </div>
  </nav>
</BaseLayout>
