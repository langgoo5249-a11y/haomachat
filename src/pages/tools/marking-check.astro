---
// 号码标记自查 - 聚合标记清除服务入口与官方平台
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolFaq from '@components/ToolFaq.astro';
import ToolScenarios from '@components/ToolScenarios.astro';
import ToolComparison from '@components/ToolComparison.astro';
import ToolFacts from '@components/ToolFacts.astro';
import platformsData from '@data/platforms.json';

const platforms = platformsData.platforms;

// 判断字符串是否为 URL
const isUrl = (s: string) => /^https?:\/\//.test(s);

// 公司服务链接
// ⛔ 死规定：此链接为合作方真实服务地址，永远不得修改、替换或移除。
const serviceUrl = 'https://xbh5.open10086.com/#/?authorization=f91029a83a8758aa';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码标记自查', url: '/tools/marking-check' },
];

const pageUpdated = '2026-09-28';

const toolWebAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '号码标记自查工具',
  description: '查询手机号码与座机号码在360、腾讯、百度、华为、泰迪熊、电话邦等主流平台的标记情况，支持手机号与固话。',
  url: 'https://zangxixitech.cn/tools/marking-check/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  provider: { '@type': 'Organization', name: '号码通查', url: 'https://zangxixitech.cn' },
  featureList: '360标记查询,腾讯标记查询,百度标记查询,华为标记查询,泰迪熊标记查询,电话邦标记查询,信通院跨平台查询',
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '如何自查号码标记',
  description: '查询手机号码与座机号码被标记情况的完整步骤,支持手机号与固话。',
  totalTime: 'PT5M',
  step: [
    {
      '@type': 'HowToStep',
      name: '步骤一: 进入标记查询服务',
      text: '点击本页标记查询入口,输入您的手机号码或座机(固话)号码,系统将查询该号码的标记情况。手机号与座机号均支持。',
      url: serviceUrl,
    },
    {
      '@type': 'HowToStep',
      name: '步骤二: 到中国信通院码号服务推进组查询',
      text: '访问 opene164.org.cn,这是国内唯一官方跨平台号码标记查询入口,支持手机号与座机号免费查询,可一次查询多平台标记情况。',
      url: 'https://www.opene164.org.cn',
    },
    {
      '@type': 'HowToStep',
      name: '步骤三: Truecaller查询(海外标记)',
      text: '若号码有国际往来,访问 truecaller.com/search,输入带国家码的号码(如+8613xxxxxxxxx)查询海外标记情况。',
      url: 'https://www.truecaller.com/search',
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '号码标记自查服务',
  description: '查询手机号与座机(固话)在360、腾讯、百度、华为、泰迪熊、电话邦等平台的标记状态。',
  url: 'https://zangxixitech.cn/tools/marking-check/',
  serviceType: '号码标记查询',
  provider: { '@id': 'https://zangxixitech.cn/#organization' },
  areaServed: { '@type': 'Country', name: 'CN' },
  availableChannel: [
    { '@type': 'ServiceChannel', serviceUrl: serviceUrl, name: '在线查询入口' },
    { '@type': 'ServiceChannel', serviceUrl: 'https://www.opene164.org.cn', name: '中国信通院码号服务推进组' },
  ],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY', availability: 'https://schema.org/InStock' },
  category: '号码服务',
  dateModified: pageUpdated,
};

// FAQ 单一数据源: 同时用于可见区块与 FAQPage 结构化数据, 保证两者一致
const faqs = [
  {
    q: '座机号码能查标记吗？',
    a: '可以。号码通查的标记查询服务与中国信通院码号服务推进组均支持座机(固话)号码的标记查询,输入带区号的座机号码即可查询,手机号与座机号的查询均免费。',
  },
  {
    q: '手机号被标记在哪查最全？',
    a: '推荐三渠道组合查询。第一步用本站标记查询入口,支持手机号与座机号;第二步到中国信通院码号服务推进组(opene164.org.cn),这是国内唯一官方跨平台查询入口,可一次看到多平台标记;第三步,若号码有国际往来,再到 Truecaller 查海外标记。三渠道配合可覆盖国内与国际标记。',
  },
  {
    q: '号码标记查询收费吗？会被存储吗？',
    a: '查询全部免费,也无需注册。号码通查本身不存储您输入的号码,查询在合作方服务页面完成;中国信通院码号服务推进组与 Truecaller 的查询同样免费。若需发起申诉,信通院会按要求留存机主信息用于比对,这一部分由其平台管理。',
  },
  {
    q: '手机上怎么查自己的号码有没有被标记？',
    a: '用手机浏览器直接打开本页,点击"立即查询标记"进入查询服务,输入号码即可,无需下载任何 App。另有一个零成本的自查方法:借用家人或同事的手机拨打自己号码,看来电界面是否显示"骚扰""推销"等标签,显示出来说明至少有一个平台标记了该号码。',
  },
  {
    q: '什么情况下会查不到标记？',
    a: '常见三种。一是标记只存在于手机厂商的本地拦截库(如部分机型自带的识别库),跨平台查询入口看不到,需要在手机端单独处理;二是号码刚被标记,各平台数据同步存在延迟,一般需要 1-3 天才能在查询结果中体现;三是诈骗类标记由运营商与公安机关管理,不在常规标记查询与清除范围内。',
  },
  {
    q: '新办的号码显示别人的标记,正常吗？',
    a: '正常,这叫二次放号继承标记。运营商号码回收后重新放号时,前机主在各平台留下的标记不会自动清除,新机主查询时会看到旧标记。这种情况需要通过标记申诉清除,可参考本站的二次放号误标记清除指南。',
  },
  {
    q: '查到标记之后要做什么？',
    a: '先记录标记类型与标记平台,截图保存作为申诉材料。误标记(骚扰、推销、中介等)可前往号码标记清除页面发起申诉,通常 1-3 个工作日处理;若标记属于诈骗类,则不属于常规清除范围,需联系运营商或公安机关。清除完成后建议再次自查,确认标记已消失。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  datePublished: '2026-07-06',
  dateModified: pageUpdated,
  inLanguage: 'zh-CN',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// 可核验数据(替代用户证言, 仅陈述可验证事实)
const facts = [
  { num: '6', unit: '大标记平台', desc: '360/腾讯/百度/华为/泰迪熊/电话邦' },
  { num: '3', unit: '大查询渠道', desc: '查询服务+信通院+Truecaller' },
  { num: '1-3', unit: '天同步延迟', desc: '新标记进入查询结果的时间' },
  { num: '0', unit: '存储', desc: '本站不存储查询号码' },
];

// 场景卡矩阵: 每卡对应一个可搜索的长尾场景
const scenarios = [
  { title: '手机号被标记自查', desc: '查手机号在 360/腾讯/百度/华为等平台的标记情况', href: '/tools/marking-clear/' },
  { title: '座机/固话被标记自查', desc: '输入带区号的固话号,查企业总机是否被标记', href: '/guide/landline-marking-clear/' },
  { title: '新办号码显示旧标记', desc: '二次放号继承前机主标记,先查清范围再申诉', href: '/blog/2026-recycled-number-false-marking-guide/' },
  { title: '客户说打过去显示骚扰', desc: '确认号码是否被多个平台同时标记', href: '/blog/2026-phone-manufacturer-local-marking-database-clear-guide/' },
  { title: '企业 400 号码被标记', desc: '查 400 客服号在各平台的标记状态', href: '/blog/2026-enterprise-400-number-marking-clear-guide/' },
  { title: '95/96 企业号码被标记', desc: '查客服号段被标记的平台分布', href: '/blog/2026-enterprise-95-96-number-marking-clear-guide/' },
  { title: '销售外呼号被标记', desc: '高频外呼后自查标记范围与频次', href: '/blog/2026-high-frequency-outbound-number-marking-solution/' },
  { title: '海外客户说被标记', desc: '补查 Truecaller 等海外标记库', href: '/blog/2026-international-call-marking-guide/' },
  { title: '清除后复查是否反弹', desc: '清除完成后再次查询,确认标记已消除', href: '/blog/2026-phone-marking-recurrence-after-clearance/' },
];

const comparisonRows = [
  { dim: '需要打开几个入口', old: '6 个以上平台逐个查一遍', ours: '1 个入口 + 信通院官方交叉验证' },
  { dim: '是否容易漏查', old: '容易漏掉厂商本地库与海外标记库', ours: '三渠道覆盖国内与国际标记' },
  { dim: '耗时', old: '逐个平台验证,通常 20 分钟以上', ours: '输入号码即可,大约 1 分钟' },
  { dim: '费用', old: '查询免费,但需自行分辨渠道真伪', ours: '查询全程免费,渠道来源公开透明' },
  { dim: '座机号支持', old: '部分平台不支持固话查询', ours: '手机号与座机号均支持' },
  { dim: '查完怎么清除', old: '需自己再找各平台申诉入口', ours: '直接跳转标记清除或走信通院官方申诉' },
];
---
<BaseLayout
  title="2026最新号码标记自查：怎么查自己号码被标记？6平台免费查 | 号码通查"
  description="想知道手机号/座机被哪些平台标记？号码通查汇总360、腾讯、百度、华为、泰迪熊、电话邦及信通院官方查询入口，免费自查标记情况，手机与座机均支持。"
  schema={[howToSchema, faqSchema, toolWebAppSchema, serviceSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- AI 摘要: 前150字结论前置 -->
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码标记自查 — 手机号 / 座机号均可查询</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    号码标记自查是指查询手机号码或座机(固话)号码被各平台标记的情况。本站提供标记查询服务入口,支持手机号与座机号;同时聚合中国信通院码号服务推进组(opene164.org.cn,国内唯一官方跨平台查询入口)与Truecaller(全球来电识别)官方查询入口。三个渠道配合,可覆盖国内与国际标记,查询均免费。
  </p>

  <!-- 核心查询入口 -->
  <section class="mb-8">
    <div class="card border-l-4 border-l-brand-600 p-6 flex flex-col md:flex-row items-center gap-6">
      <div class="w-12 h-12 rounded-lg bg-brand-50 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <div class="flex-1 text-center md:text-left">
        <h2 class="text-lg font-bold text-slate-800">号码标记自查 — 手机号 / 座机号</h2>
        <p class="text-sm text-slate-500 mt-1">输入手机号码或座机号码,查询被标记情况</p>
      </div>
      <a href={serviceUrl} target="_blank" rel="noopener" class="px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 whitespace-nowrap transition-colors">立即查询标记 →</a>
    </div>
  </section>

  <!-- 可核验数据 -->
  <ToolFacts facts={facts} />

  <!-- 查询入口表格 -->
  <section class="prose-content mb-8">
    <h2>号码标记查询入口一览</h2>
    <p>
      下表汇总了可用的号码标记查询渠道。<strong>标记查询服务</strong>支持手机号与座机号,推荐优先使用;<strong>中国信通院码号服务推进组</strong>是国内唯一官方跨平台聚合查询入口;Truecaller适合查询海外标记。
    </p>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>查询渠道</th>
            <th>类型</th>
            <th>查询入口</th>
            <th>支持号码</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((p) => (
            <tr>
              <td><strong>{p.name}</strong></td>
              <td>{p.type}</td>
              <td>
                {p.queryUrl && isUrl(p.queryUrl) ? (
                  <a href={p.queryUrl} target="_blank" rel="noopener nofollow">点击查询</a>
                ) : (
                  <span>{p.note}</span>
                )}
              </td>
              <td>手机号 / 座机号</td>
              <td>{p.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 各渠道操作说明 -->
  <section class="prose-content mb-8">
    <h2>各渠道查询操作说明</h2>

    <h3>1. 标记查询服务(推荐优先)</h3>
    <p>
      点击上方"立即查询标记"按钮进入查询服务,输入您的<strong>手机号码或座机号码</strong>即可查询标记情况。手机号与座机号均支持,操作便捷,查询免费。
    </p>

    <h3>2. 中国信通院码号服务推进组</h3>
    <p>
      访问 <a href="https://www.opene164.org.cn" target="_blank" rel="noopener nofollow">opene164.org.cn</a>,该平台由中国信息通信研究院运营,是国内<strong>唯一官方跨平台号码标记查询入口</strong>。支持手机号码、座机(固话)号码免费查询,会聚合展示该号码在各标记平台的标记情况。查询完全免费,无需注册。
    </p>

    <h3>3. Truecaller(海外来电识别)</h3>
    <p>
      访问 <a href="https://www.truecaller.com/search" target="_blank" rel="noopener nofollow">truecaller.com/search</a>,Truecaller 是全球最大来电识别应用。若号码有国际往来或被海外用户标记,需在此查询。输入带国家码的号码(如 +8613xxxxxxxxx)即可查询。
    </p>
  </section>

  <!-- 场景卡矩阵 -->
  <ToolScenarios
    title="按场景解决号码标记问题"
    intro="不同号码类型和业务场景,查询重点不同。找到最接近你情况的一项,直接看对应方案。"
    scenarios={scenarios}
  />

  <!-- 方案对比 -->
  <ToolComparison
    title="方案对比: 逐个平台查 vs 一站式自查"
    intro="自己逐个平台排查容易漏,尤其是手机厂商本地库和海外标记库。"
    oldLabel="自己逐个平台查"
    oursLabel="号码通查一站式自查"
    rows={comparisonRows}
  />

  <!-- 自查步骤 -->
  <section class="prose-content mb-8">
    <h2>号码标记自查步骤</h2>
    <ol class="list-decimal list-inside mb-4 text-slate-600 space-y-2">
      <li>
        <strong>第一步:使用标记查询服务。</strong>点击本页查询入口,输入手机号或座机号,获取标记情况概览。
      </li>
      <li>
        <strong>第二步:到信通院官方查询。</strong>访问 opene164.org.cn,进行官方跨平台查询,确认标记详情。
      </li>
      <li>
        <strong>第三步:Truecaller查询(如需)。</strong>号码有国际往来时,到 truecaller.com/search 查询海外标记。
      </li>
      <li>
        <strong>第四步:记录并准备清除。</strong>将标记类型与平台记录下来,截图保存。发现错误标记后,可前往<a href="/tools/marking-clear">号码标记清除</a>页面操作清除。
      </li>
    </ol>
  </section>

  <!-- 注意事项 -->
  <section class="prose-content mb-8">
    <h2>自查注意事项</h2>
    <ul>
      <li>本站标记查询服务支持手机号与座机(固话)号码,座机号需输入区号。</li>
      <li>中国信通院码号服务推进组同样支持手机号与座机号查询,可交叉验证。</li>
      <li>号码回收再发放后可能继承前机主的标记,新办的号也可能被误标。</li>
      <li>本页仅提供查询入口引导,不存储任何号码数据,所有查询在各渠道官方页面完成。</li>
      <li>如查询后需清除错误标记,请前往<a href="/tools/marking-clear">号码标记清除</a>页面。</li>
    </ul>
  </section>

  <!-- 常见问题 -->
  <ToolFaq
    faqs={faqs}
    heading="号码标记自查常见问题"
    intro="以下问题覆盖查询范围、隐私、手机端操作与查不到标记的几种情况。"
  />

  <!-- 数据来源声明 -->
  <section class="bg-slate-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-slate-800 mb-2">数据来源</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      本页查询渠道包括:标记查询服务(支持手机号与座机号)、中国信通院码号服务推进组(opene164.org.cn,官方跨平台入口)、Truecaller(truecaller.com,全球来电识别)。本站不存储用户查询的号码数据,所有查询均在各渠道官方页面完成,免费使用。
    </p>
  </section>

  <!-- 相关工具交叉链接 -->
  <nav class="mt-6 pt-6 border-t border-slate-200">
    <h2 class="text-lg font-bold text-slate-800 mb-3">相关工具与指南</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/marking-clear/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">号码标记清除</a>
      <a href="/tools/number-auth/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">号码认证</a>
      <a href="/tools/attribution/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">归属地查询</a>
      <a href="/tools/legal-number-verify/" class="text-sm px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-brand-50 hover:text-brand-600 transition-colors">法人号码核验</a>
