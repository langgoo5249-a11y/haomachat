const codeCloudflareFn = `// functions/api/attribution.js
// Cloudflare Pages Function: 服务端代理,上游 API Key 仅存于环境变量
export async function onRequestGet({ request, env }) {
  const url = new URL(request.url);
  const phone = url.searchParams.get('phone');

  // 1. 参数校验
  if (!phone) {
    return Response.json(
      { code: 400, message: '缺少 phone 参数' },
      { status: 400 }
    );
  }
  const cleaned = phone.replace(/[\\s-]/g, '');
  if (!/^(\\d{11}|\\d{3,4}\\d{7,8})$/.test(cleaned)) {
    return Response.json(
      { code: 400, message: 'phone 格式不正确' },
      { status: 400 }
    );
  }

  // 2. 调用上游数据源(Key 仅在服务端可见)
  const upstream = \`https://apis.juhe.cn/mobile/get?phone=\${encodeURIComponent(cleaned)}&key=\${env.JUHE_API_KEY}\`;
  const resp = await fetch(upstream);
  const json = await resp.json();

  // 3. 归一化返回
  if (json.error_code !== 0) {
    return Response.json(
      { code: 404, message: '归属地未找到' },
      { status: 404 }
    );
  }
  const r = json.result;
  return Response.json({
    code: 200,
    message: 'success',
    data: {
      phone: cleaned,
      province: r.province,
      city: r.city,
      carrier: r.company,
      areacode: r.areacode,
      postcode: r.zip,
      numberType: cleaned.length === 11 ? '手机号' : '固话',
    },
  });
}`;

