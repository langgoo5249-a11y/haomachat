---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const site = 'https://zangxixitech.cn';

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // 使用 encodeURIComponent 编码中文标签作为 URL 参数
  const tagMap = new Map<string, BlogPost[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const list = tagMap.get(tag) ?? [];
      list.push(post);
      tagMap.set(tag, list);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, tagPosts]) => ({
    params: { slug: encodeURIComponent(tag) },
    props: {
      tag,
      posts: [...tagPosts].sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
      ),
    },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;

// 解码 slug 获取原始标签
const decodedTag = decodeURIComponent(Astro.params.slug);

const tagPageUrl = `${site}/tags/${encodeURIComponent(decodedTag)}/`;

const pageTitle = `${decodedTag}相关文章合集（${posts.length}篇） | 号码通查号码百科`;
const pageDescription = `号码通查号码百科中关于「${decodedTag}」的全部 ${posts.length} 篇文章合集，按发布时间倒序排列，涵盖号码标记查询、清除、申诉、号码认证等实操指南，内容基于中国信通院与各标记平台官方公开渠道，可追溯验证。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码百科', url: '/blog' },
  { name: '标签', url: '/tags/' },
  { name: decodedTag, url: `/tags/${encodeURIComponent(decodedTag)}/` },
];

// CollectionPage Schema: 声明这是一个标签聚合落地页(GEO 信号)
const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${tagPageUrl}#webpage`,
  name: pageTitle,
  description: pageDescription,
  url: tagPageUrl,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': `${site}/blog/` },
  breadcrumb: { '@id': `${tagPageUrl}#breadcrumb` },
  mainEntity: { '@id': `${tagPageUrl}#itemlist` },
};

// ItemList Schema: 每篇文章一个 ListItem, 帮助 AI 引擎理解标签页的列表结构
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${tagPageUrl}#itemlist`,
  name: `「${decodedTag}」标签下的全部文章`,
  description: pageDescription,
  numberOfItems: posts.length,
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.title,
    url: `${site}/blog/${post.id}/`,
  })),
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[collectionPageSchema, itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">{decodedTag}</h1>
  <p class="text-slate-600 mb-8 leading-relaxed">
    号码通查号码百科中关于「{decodedTag}」的全部 {posts.length} 篇文章，按发布时间倒序排列。
  </p>

  <div class="space-y-4">
    {posts.map((post) => (
      <article class="bg-white rounded-xl border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all p-5">
        <div class="text-xs text-slate-400 mb-1.5">{post.data.pubDate.toLocaleDateString('zh-CN')} · {post.data.author}</div>
        <h2 class="text-base font-semibold text-slate-800 mb-1.5 leading-snug">
          <a href={`/blog/${post.id}/`} class="hover:text-brand-600 transition-colors">{post.data.title}</a>
        </h2>
        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 mb-2.5">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((t) => (
              <a
                href={`/tags/${encodeURIComponent(t)}/`}
                class={`text-xs px-2 py-0.5 rounded transition-colors ${t === decodedTag ? 'bg-brand-50 text-brand-600' : 'bg-slate-100 text-slate-500 hover:bg-brand-50 hover:text-brand-600'}`}
              >{t}</a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>

  {posts.length === 0 && (
    <p class="text-slate-500 text-center py-12">该标签下暂无文章,敬请期待。</p>
  )}

  <div class="pt-8 pb-16 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
    <a href="/tags/" class="text-brand-600 hover:underline">查看全部标签 →</a>
    <a href="/blog/" class="text-slate-500 hover:text-brand-600 transition-colors">← 返回号码百科</a>
  </div>
</BaseLayout>
