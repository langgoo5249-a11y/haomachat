---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tagToSlug } from '@/utils/tag-slug';

const site = 'https://zangxixitech.cn';

const posts = await getCollection('blog');

// 统计每个标签的文章数, 按文章数倒序排列
const tagCountMap = new Map<string, { count: number; latest: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const entry = tagCountMap.get(tag) ?? { count: 0, latest: 0 };
    entry.count += 1;
    entry.latest = Math.max(entry.latest, post.data.pubDate.valueOf());
    tagCountMap.set(tag, entry);
  }
}
const tags = Array.from(tagCountMap.entries())
  .sort((a, b) => b[1].count - a[1].count || b[1].latest - a[1].latest)
  .map(([tag, { count }]) => ({ tag, count }));

const totalPosts = posts.length;

const pageTitle = '标签目录 | 号码通查号码百科';
const pageDescription = `号码通查号码百科全部 ${tags.length} 个话题标签目录，覆盖号码标记、标记清除、号码认证、企业号码、申诉教程等主题，共 ${totalPosts} 篇文章，点击标签查看对应文章合集。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码百科', url: '/blog' },
  { name: '标签', url: '/tags/' },
];

// CollectionPage + ItemList Schema: 声明标签目录页结构, 便于 AI 引擎按标签检索内容
const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}/tags/#webpage`,
  name: pageTitle,
  description: pageDescription,
  url: `${site}/tags/`,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': `${site}/blog/` },
  breadcrumb: { '@id': `${site}/tags/#breadcrumb` },
  mainEntity: { '@id': `${site}/tags/#itemlist` },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${site}/tags/#itemlist`,
  name: '号码通查号码百科 - 标签目录',
  description: pageDescription,
  numberOfItems: tags.length,
  itemListElement: tags.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.tag,
    url: `${site}/tags/${encodeURIComponent(tagToSlug(item.tag))}/`,
  })),
};
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[collectionPageSchema, itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">标签目录</h1>
  <p class="text-slate-600 mb-8 leading-relaxed">
    号码通查号码百科的全部 {tags.length} 个话题标签，按文章数量倒序排列。点击任意标签查看该主题下的全部文章合集。
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pb-8">
    {tags.map(({ tag, count }) => (
      <a
        href={`/tags/${encodeURIComponent(tagToSlug(tag))}/`}
        class="group flex items-center justify-between bg-white rounded-xl border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all px-4 py-3"
      >
        <span class="text-sm font-medium text-slate-700 group-hover:text-brand-600 transition-colors truncate">{tag}</span>
        <span class="ml-3 flex-shrink-0 text-xs px-2 py-0.5 bg-slate-100 text-slate-500 rounded group-hover:bg-brand-50 group-hover:text-brand-600 transition-colors">{count} 篇</span>
      </a>
    ))}
  </div>

  {tags.length === 0 && (
    <p class="text-slate-500 text-center py-12">暂无标签,敬请期待。</p>
  )}

  <div class="pb-16">
    <a href="/blog/" class="text-slate-500 hover:text-brand-600 transition-colors text-sm">← 返回号码百科</a>
  </div>
</BaseLayout>
