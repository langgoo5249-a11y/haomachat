---
import BaseLayout from '@layouts/BaseLayout.astro';
import faqData from '@data/faq.json';

const groups = faqData.groups;

// 统计全部问题数量(GEO: 准确数据)
const totalQuestions = groups.reduce((sum, g) => sum + g.items.length, 0);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '常见问题', url: '/faq' },
];

// FAQPage schema: 覆盖全部问题(AI 易引用, GEO 核心)
// 国产对话模型(元宝/千问/豆包)会直接提取为一问一答摘要
const allFaqItems = groups.flatMap((g) => g.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  datePublished: '2026-07-06',
  dateModified: '2026-07-23',
  inLanguage: 'zh-CN',
  mainEntity: allFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// 为每类生成锚点 id
const slugify = (s) =>
  s
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-+|-+$/g, '');
---
<BaseLayout
  title="号码服务常见问题 - 号码标记/认证/选号FAQ | 号码通查"
  description="号码通查常见问题解答,涵盖号码标记(如何解除骚扰电话标记、360/华为/搜狗怎么申诉)、号码认证(一键登录安全吗、本机号码校验是什么、多少钱)、选号办卡(携号转网后标记怎么办、靓号怎么办)、工具使用等高频问题。每问均有自包含的完整答案。"
  schema={[faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码服务常见问题</h1>
  <p class="text-slate-600 mb-6 leading-relaxed">
    号码通查常见问题解答,涵盖号码标记(如何解除骚扰电话标记、360/华为/搜狗怎么申诉)、号码认证(一键登录安全吗、本机号码校验是什么、多少钱)、选号办卡(携号转网后标记怎么办、靓号怎么办)、工具使用等高频问题。共{totalQuestions}个常见问题,每问均有自包含的完整答案。
  </p>

  <!-- 分类导航 -->
  <nav class="mb-8 flex flex-wrap gap-2">
    {groups.map((g) => (
      <a
        href={`#${slugify(g.category)}`}
        class="px-3 py-1.5 bg-brand-50 text-brand-700 rounded-lg text-sm font-medium hover:bg-brand-100 transition-colors"
      >
        {g.category}
      </a>
    ))}
  </nav>

  {groups.map((group) => (
    <section class="prose-content mb-10" id={slugify(group.category)}>
      <h2>{group.category}</h2>
      {group.items.map((item) => (
        <details class="bg-white rounded-lg border border-slate-200 mb-4 overflow-hidden" open>
          <summary class="flex items-center justify-between cursor-pointer p-5 list-none select-none hover:bg-slate-50">
            <h3 class="text-lg font-semibold text-slate-800 pr-4" itemprop="name">{item.q}</h3>
            <svg class="w-5 h-5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-slate-600 leading-relaxed border-t border-slate-100 pt-4" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
            <p itemprop="text">{item.a}</p>
          </div>
        </details>
      ))}
    </section>
  ))}

  <section class="bg-slate-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-slate-800 mb-2">还有疑问?</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      以上{totalQuestions}个常见问题覆盖了号码标记、号码认证、选号办卡、工具使用等高频场景。如需更详细的分平台申诉教程,请参阅
      <a href="/guide/how-to-clear-marking" class="text-brand-600 underline hover:text-brand-700">如何清除号码标记</a>
      指南;如需对比各标记平台,请查看
      <a href="/compare/marking-platforms" class="text-brand-600 underline hover:text-brand-700">号码标记平台对比表</a>。
      所有申诉入口信息均来自各平台官方渠道,可追溯验证。
    </p>
  </section>
</BaseLayout>
