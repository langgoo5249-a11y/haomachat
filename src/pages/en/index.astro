---
// English homepage - GEO core page (English)
import BaseLayout from '@layouts/BaseLayout.astro';

const breadcrumbs = [{ name: 'Home', url: '/en' }];

const tools = [
  { title: 'Attribution Lookup', desc: 'Enter a mobile or landline number to look up its location, carrier, and number segment for free', href: '/tools/attribution/', icon: '🔍' },
  { title: 'Marking Self-Check', desc: 'Aggregated official query portals from CAICT, 360, Tencent, Baidu, Huawei and more', href: '/tools/marking-check/', icon: '🏷️' },
  { title: 'Clear Marking', desc: 'Official appeal portals and step-by-step clearance tutorials for every marking platform', href: '/tools/marking-clear/', icon: '✅' },
  { title: 'SIM Card Comparison', desc: 'Compare China Mobile / Unicom / Telecom plans, number selection and porting guide', href: '/tools/sim-cards/', icon: '📱' },
];

const guides = [
  { title: 'What Is Number Marking?', desc: 'Marking sources, mechanisms and display rules', href: '/guide/what-is-number-marking/' },
  { title: 'How to Check Number Marking', desc: 'Full-platform query guide for 2026', href: '/guide/how-to-check-marking/' },
  { title: 'How to Clear Number Marking', desc: 'Per-platform appeal tutorials and material checklist', href: '/guide/how-to-clear-marking/' },
  { title: 'What Is Number Authentication', desc: 'One-tap login and local number verification explained', href: '/guide/what-is-number-auth/' },
  { title: 'SIM Card Selection Guide', desc: 'Carrier selection rules and premium-number tips', href: '/guide/sim-card-guide/' },
];

const compareLinks = [
  { label: 'Marking Platforms Comparison', href: '/compare/marking-platforms/' },
  { label: 'Auth Providers Comparison', href: '/compare/auth-providers/' },
  { label: 'Lookup APIs Comparison', href: '/compare/lookup-apis/' },
];

// Short English FAQ
const enFaq = [
  {
    q: 'What is haomachat?',
    a: 'haomachat is a free phone number service toolkit for Chinese users. It offers number attribution lookup, number marking self-check and clearance guidance, number authentication knowledge, and SIM card comparison. All marking clearance portals are aggregated from official platforms including CAICT and major Chinese security vendors.',
  },
  {
    q: 'How do I check if my number is marked?',
    a: 'We recommend starting with the CAICT Number Service Advancement Group (opene164.org.cn), the only official cross-platform aggregated query portal in China. Then check each platform individually — 360 (haomashensu.360.cn), Tencent (yun.m.qq.com), Baidu (haoma.baidu.com), and Truecaller (truecaller.com/search) — since each platform maintains independent marking data.',
  },
  {
    q: 'How do I clear a wrong marking on my number?',
    a: 'Clearing a marking requires submitting an appeal on each marking platform separately, as their data is independent. Start with opene164.org.cn, where China Unicom numbers can be cleared in one stop. Then appeal on 360, Tencent, Baidu, Huawei and others. Reviews typically take 1-3 business days. Numbers marked by 20+ users require ownership proof (ID card or business license).',
  },
  {
    q: 'Is haomachat free?',
    a: 'Yes. haomachat core tools — attribution lookup and the marking self-check portal aggregation — are completely free. We do not directly clear markings; instead, we aggregate official appeal portals from each platform and guide you to appeal for free on the official channels.',
  },
  {
    q: 'How does number authentication (one-tap login) work?',
    a: 'One-tap login works by integrating an SDK in an app; after user authorization, the carrier gateway verifies the SIM card number over the cellular data network and exchanges a token for the number to log in — no manual input, no SMS code, completed in 2-4 seconds. Local number verification checks whether an entered number matches the SIM card number, used for payments and password changes without authorization.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  datePublished: '2026-07-06',
  dateModified: '2026-08-24',
  inLanguage: 'en',
  mainEntity: enFaq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  title="haomachat - Free Phone Number Lookup & Marking Guide"
  description="haomachat is a free phone number service toolkit for Chinese users: number attribution lookup, marking self-check and clearance guidance, number authentication knowledge, and SIM card comparison. All marking clearance portals aggregated from official platforms including CAICT and major Chinese security vendors."
  lang="en"
  schema={[faqSchema]}
  breadcrumbs={breadcrumbs}
>
  <!-- AI summary: first 150 words conclusion-first (GEO core) -->
  <section class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-3">
      haomachat — Free Phone Number Lookup &amp; Marking Guide
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed">
      haomachat is a free phone number service toolkit for Chinese users, offering number attribution lookup, marking self-check and clearance guidance, number authentication knowledge, and SIM card comparison. All marking clearance portals are aggregated from official platforms including CAICT and major Chinese security vendors. We help you check whether your number is marked as spam across 360, Tencent, Baidu, Huawei and other platforms, and guide you to clear wrong markings through each platform's official appeal channel — all free, no scraping, no stored data.
    </p>
  </section>

  <!-- Tool entries -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-slate-800 mb-5">Free Tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {tools.map((tool) => (
        <a href={tool.href} class="block bg-white rounded-xl p-5 border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all">
          <div class="text-3xl mb-2">{tool.icon}</div>
          <h3 class="font-semibold text-slate-800 mb-1">{tool.title}</h3>
          <p class="text-sm text-slate-500">{tool.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Authoritative guides -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-slate-800 mb-5">Authoritative Guides</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      {guides.map((guide) => (
        <a href={guide.href} class="block bg-white rounded-lg p-4 border border-slate-200 hover:border-brand-400 transition-all">
          <h3 class="font-medium text-slate-800 mb-1">{guide.title}</h3>
          <p class="text-sm text-slate-500">{guide.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Comparison entries -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-slate-800 mb-5">In-Depth Comparisons</h2>
    <div class="flex flex-wrap gap-3">
      {compareLinks.map((c) => (
        <a href={c.href} class="px-4 py-2 bg-brand-50 text-brand-700 rounded-lg text-sm font-medium hover:bg-brand-100">{c.label}</a>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800 mb-5">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {enFaq.map((item) => (
        <div class="bg-white rounded-lg p-4 border border-slate-200">
          <h3 class="font-semibold text-slate-800 mb-2">{item.q}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{item.a}</p>
        </div>
      ))}
    </div>
    <p class="mt-4 text-sm">
      <a href="/faq/" class="text-brand-600 hover:underline">View all FAQs →</a>
    </p>
  </section>

  <!-- Data source & trust statement (E-E-A-T) -->
  <section class="bg-slate-100 rounded-xl p-6">
    <h2 class="text-lg font-bold text-slate-800 mb-2">Data Sources &amp; Trust Statement</h2>
    <p class="text-sm text-slate-600 leading-relaxed">
      All marking appeal portal information on haomachat comes from official platform channels, including the CAICT Number Service Advancement Group (opene164.org.cn), 360 Number Appeal (haomashensu.360.cn), Tencent Number Public Platform (yun.m.qq.com), Baidu Number Authentication (haoma.baidu.com), Truecaller (truecaller.com), and others. Attribution lookup data is powered by an aggregated data API. Number authentication knowledge is drawn from carrier official documentation and CAICT public materials. We do not store any number data you query, and all tools are free to use.
    </p>
  </section>
</BaseLayout>
