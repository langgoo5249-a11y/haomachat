---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码百科', url: '/blog' },
];

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: '号码通查号码百科',
  description: '号码标记清除、号码认证选型、手机卡选号等深度文章',
  url: 'https://zangxixitech.cn/blog',
  publisher: { '@id': 'https://zangxixitech.cn/#organization' },
};

// ItemList Schema: 帮助AI引擎解析博客归档结构,理解"这里有N篇文章按时间排序"
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '号码通查号码百科 - 全部文章',
  description: '号码标记清除、号码认证选型、手机卡选号等深度文章列表',
  numberOfItems: posts.length,
  itemListElement: posts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: post.data.title,
    url: `https://zangxixitech.cn/blog/${post.id}/`,
    description: post.data.description,
  })),
};
---
<BaseLayout
  title="号码百科 - 号码标记/认证/选号深度文章 | 号码通查"
  description="号码通查号码百科,发布号码标记清除教程、号码认证选型指南、手机卡选号攻略、号码标记平台对比实测等深度文章。内容基于中国信通院官方数据与行业实践,含真实案例、踩坑备注与平台通过率数据,可追溯验证。"
  schema={[blogSchema, itemListSchema]}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-3xl font-bold text-slate-800 mb-3">号码百科</h1>
  <p class="text-slate-600 mb-8 leading-relaxed">
    号码通查号码百科发布电话号码服务领域的深度文章,涵盖号码标记查询与清除教程、号码认证(一键登录/本机号码校验)选型指南、手机卡选号攻略等。所有内容基于中国信通院、各平台官方渠道与运营商公开资料,可追溯验证。
  </p>

  <div class="space-y-5 pb-20">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="block bg-white rounded-xl border border-slate-200 hover:border-brand-400 hover:shadow-md transition-all overflow-hidden">
        <!-- 配图: 移动端全宽在上, 桌面端保持整卡结构 -->
        {post.data.heroImage ? (
          <img
            src={post.data.heroImage}
            alt={post.data.heroDescription || post.data.title}
            class="w-full aspect-[16/9] object-cover"
            width="1200"
            height="675"
            loading="lazy"
          />
        ) : (
          <div class="w-full aspect-[16/9] bg-slate-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        )}
        <div class="p-4">
          <div class="text-xs text-slate-400 mb-1">{post.data.pubDate.toLocaleDateString('zh-CN')} · {post.data.author}</div>
          <h2 class="text-base font-semibold text-slate-800 mb-1.5 leading-snug">{post.data.title}</h2>
          <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 bg-slate-100 text-slate-500 rounded">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>

  {posts.length === 0 && (
    <p class="text-slate-500 text-center py-12">暂无文章,敬请期待。</p>
  )}
</BaseLayout>
