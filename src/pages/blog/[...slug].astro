---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '号码百科', url: '/blog' },
  { name: post.data.title, url: `/blog/${post.id}/` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: 'https://zangxixitech.cn/about',
    description: '号码通查 - 电话号码标记查询与清除服务工具站,由脏兮兮科技运营',
    knowsAbout: ['电话号码标记', '号码标记清除', '号码认证', '号码归属地查询', '法人号码核验'],
  },
  publisher: {
    '@type': 'Organization',
    name: '号码通查',
    logo: { '@type': 'ImageObject', url: 'https://zangxixitech.cn/favicon.svg' },
  },
  mainEntityOfPage: `https://zangxixitech.cn/blog/${post.id}/`,
  image: {
    '@type': 'ImageObject',
    url: 'https://zangxixitech.cn/og-default.jpg',
    width: 1200,
    height: 630,
  },
  keywords: post.data.tags.join(', '),
};

// BlogPosting JSON-LD: BlogPosting 是 Article 的子类型,部分 AI 引擎(如 Perplexity)对 BlogPosting 解析更精准
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: 'https://zangxixitech.cn/about',
  },
  publisher: {
    '@type': 'Organization',
    name: '号码通查',
    logo: { '@type': 'ImageObject', url: 'https://zangxixitech.cn/favicon.svg' },
  },
  mainEntityOfPage: `https://zangxixitech.cn/blog/${post.id}/`,
  image: {
    '@type': 'ImageObject',
    url: 'https://zangxixitech.cn/og-default.jpg',
    width: 1200,
    height: 630,
  },
  keywords: post.data.tags.join(', '),
  wordCount: post.body?.length || 0,
  articleSection: '号码百科',
};
---
<BaseLayout
  title={`${post.data.title} | 号码通查号码百科`}
  description={post.data.description}
  schema={[articleSchema, blogPostingSchema]}
  breadcrumbs={breadcrumbs}
  ogType="article"
  publishedDate={post.data.pubDate.toISOString()}
  modifiedDate={(post.data.updatedDate || post.data.pubDate).toISOString()}
>
  <article class="prose-content max-w-none">
    <div class="text-sm text-slate-400 mb-2">
      {post.data.pubDate.toLocaleDateString('zh-CN')} · {post.data.author}
    </div>
    <h1 class="text-3xl font-bold text-slate-800 mb-4">{post.data.title}</h1>
    <p class="text-lg text-slate-600 mb-6">{post.data.description}</p>
    <Content />
  </article>

  <div class="mt-8 pt-6 border-t border-slate-200">
    <a href="/blog" class="text-brand-600 hover:underline">← 返回号码百科</a>
  </div>
</BaseLayout>
