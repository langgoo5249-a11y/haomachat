---
// Header 导航组件
export interface Props {
  lang?: 'zh' | 'en';
}
const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';

const navItems = isEn
  ? [
      { label: 'Attribution', href: '/tools/attribution/' },
      { label: 'Marking Check', href: '/tools/marking-check/' },
      { label: 'Clear Marking', href: '/tools/marking-clear/' },
      { label: 'Guides', href: '/guide/what-is-number-marking/' },
      { label: 'Compare', href: '/compare/marking-platforms/' },
      { label: 'FAQ', href: '/faq/' },
      { label: 'Blog', href: '/blog/' },
    ]
  : [
      { label: '标记清除', href: '/tools/marking-clear/' },
      { label: '号码认证', href: '/tools/number-auth/' },
      { label: '法人核验', href: '/tools/legal-number-verify/' },
      { label: '注册卡', href: '/tools/registration-card/' },
      { label: '标记自查', href: '/tools/marking-check/' },
      { label: '归属地', href: '/tools/attribution/' },
      { label: '指南', href: '/guide/what-is-number-marking/' },
      { label: 'FAQ', href: '/faq/' },
      { label: '号码百科', href: '/blog/' },
    ];
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href={isEn ? '/en' : '/'} class="flex items-center gap-2 font-bold text-lg text-brand-700">
      <img src="/favicon.svg" alt="号码通查" width="28" height="28" />
      <span>{isEn ? 'haomachat' : '号码通查'}</span>
    </a>
    <nav class="hidden md:flex items-center gap-4 text-sm">
      {navItems.map((item) => (
        <a href={item.href} class="text-slate-600 hover:text-brand-600 transition-colors min-h-10 px-1 flex items-center">{item.label}</a>
      ))}
    </nav>
    <a
      href={isEn ? '/' : '/en'}
      class="text-sm px-2 py-1 rounded border border-slate-300 text-slate-500 hover:border-brand-400 hover:text-brand-600 min-h-10 flex items-center justify-center"
    >
      {isEn ? '中文' : 'EN'}
    </a>
  </div>
  <!-- 移动端导航 -->
  <nav class="md:hidden flex overflow-x-auto gap-3 px-4 py-2 text-sm border-t border-slate-100">
    {navItems.map((item) => (
      <a href={item.href} class="whitespace-nowrap text-slate-600 min-h-10 px-1 flex items-center">{item.label}</a>
    ))}
  </nav>
</header>
