---
// 工具页可核验数据条
// 替代"用户证言"类主观评价, 只陈述可被验证的事实性数字, 规避虚假宣传风险。
export interface FactItem {
  num: string;
  unit: string;
  desc: string;
}

interface Props {
  facts: FactItem[];
}

const { facts } = Astro.props;
---

<section class="mb-8">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    {facts.map((fact) => (
      <div class="text-center bg-white rounded-xl border border-slate-200 p-4">
        <div class="flex items-baseline justify-center gap-1">
          <span class="text-2xl font-bold text-brand-600">{fact.num}</span>
          <span class="text-sm text-slate-500">{fact.unit}</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">{fact.desc}</p>
      </div>
    ))}
  </div>
</section>
