---
// Footer 组件 - 专业信任度建设
export interface Props {
  lang?: 'zh' | 'en';
}
const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
const year = new Date().getFullYear();
---
<footer class="border-t border-slate-200 bg-slate-800 text-slate-300 mt-12">
  <!-- 信任栏 -->
  <div class="max-w-5xl mx-auto px-4 py-6 border-b border-slate-700">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="flex flex-col items-center gap-1">
        <svg class="w-6 h-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs text-slate-400">数据来源官方</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <svg class="w-6 h-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span class="text-xs text-slate-400">不存储号码数据</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <svg class="w-6 h-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span class="text-xs text-slate-400">免费使用</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <svg class="w-6 h-6 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span class="text-xs text-slate-400">授权合作服务</span>
      </div>
    </div>
  </div>

  <!-- 链接区 -->
  <div class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-2 md:grid-cols-5 gap-6 text-sm">
    <div>
      <h3 class="font-semibold text-white mb-2">{isEn ? 'Tools' : '服务工具'}</h3>
      <ul class="space-y-2 text-slate-400">
        <li><a href="/tools/marking-clear/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Clear Marking' : '号码标记清除'}</a></li>
        <li><a href="/tools/legal-number-verify/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Legal Number Verify' : '法人号码核验'}</a></li>
        <li><a href="/tools/marking-check/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Marking Check' : '号码标记自查'}</a></li>
        <li><a href="/tools/attribution/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Attribution Lookup' : '归属地查询'}</a></li>
        <li><a href="/tools/sim-cards/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'SIM Cards' : '选号比价'}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">{isEn ? 'Guides' : '指南'}</h3>
      <ul class="space-y-2 text-slate-400">
        <li><a href="/guide/what-is-number-marking/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'What is Marking' : '号码标记是什么'}</a></li>
        <li><a href="/guide/how-to-clear-marking/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Clear Marking' : '如何清除标记'}</a></li>
        <li><a href="/guide/landline-marking-clear/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Landline Clear' : '座机标记清除'}</a></li>
        <li><a href="/guide/what-is-number-auth/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Number Auth' : '号码认证'}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">{isEn ? 'About' : '关于'}</h3>
      <ul class="space-y-2 text-slate-400">
        <li><a href="/about/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'About Us' : '关于我们'}</a></li>
        <li><a href="/contact/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Contact' : '联系我们'}</a></li>
        <li><a href="/faq/" class="hover:text-brand-400 min-h-[28px] flex items-center">FAQ</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">{isEn ? 'Legal' : '法律信息'}</h3>
      <ul class="space-y-2 text-slate-400">
        <li><a href="/privacy/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Privacy Policy' : '隐私政策'}</a></li>
        <li><a href="/terms/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Terms of Service' : '服务条款'}</a></li>
        <li><a href="/disclaimer/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Disclaimer' : '免责声明'}</a></li>
        <li><a href="/cookie-policy/" class="hover:text-brand-400 min-h-[28px] flex items-center">{isEn ? 'Cookie Policy' : 'Cookie政策'}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold text-white mb-2">{isEn ? 'Contact' : '联系方式'}</h3>
      <ul class="space-y-1 text-slate-400">
        <li>微信: <span class="text-slate-300"></span></li>
        <li>邮箱: <span class="text-slate-300">644428571@qq.com</span></li>
        <li><a href="/contact/" class="hover:text-brand-400">查看联系方式 →</a></li>
      </ul>
    </div>
  </div>

  <!-- 底部备案/版权 -->
  <div class="border-t border-slate-700 py-4">
    <div class="max-w-5xl mx-auto px-4 text-center text-xs text-slate-500 space-y-1">
      <p>© {year} {isEn ? 'haomachat' : '号码通查'} · {isEn ? 'Operated by ' : '由运营'} · <a href="/about/" class="hover:text-brand-400">{isEn ? 'About' : '关于我们'}</a></p>
      <p>{isEn ? 'Marking clearance service provided by authorized partner.' : '标记清除服务由授权合作方提供。'} {isEn ? 'Data sources: CAICT, Truecaller.' : '数据来源:中国信通院、Truecaller。'}</p>
      <p class="text-slate-600">{isEn ? 'Links: ' : '友情链接: '}<a href="/llms.txt" class="hover:text-slate-400">llms.txt</a> · <a href="/rss.xml" class="hover:text-slate-400">RSS</a> · <a href="/sitemap-index.xml" class="hover:text-slate-400">Sitemap</a></p>
    </div>
  </div>
</footer>
