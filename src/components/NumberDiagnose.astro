---
/**
 * NumberDiagnose - 号码类型识别与标记处理向导
 *
 * 真实可用: 在浏览器本地识别号码类型(手机号/座机/400/800/95/96/虚拟运营商/国际),
 * 并按 mode 给出对应的"自查"或"清除"渠道。
 *
 * 隐私: 号码不上传、不存储, 全部在本机计算。
 * 说明: 本组件只做号码类型与号段识别, 不查询真实平台标记(标记数据为各厂商私有库)。
 */
interface Props {
  mode?: 'check' | 'clear';
  serviceUrl: string;
}
const { mode = 'check', serviceUrl } = Astro.props;
const isCheck = mode === 'check';
const heading = isCheck ? '标记自查向导' : '标记清除路线向导';
const actionWord = isCheck ? '查询' : '清除';
---
<div
  id="diag-root"
  class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm mb-8"
  data-mode={mode}
  data-service={serviceUrl}
>
  <h2 class="text-lg font-bold text-slate-800 mb-1">{heading}</h2>
  <p class="text-sm text-slate-500 mb-4">
    输入号码后在本机识别号码类型与号段，返回对应的{actionWord}渠道。号码不上传、不存储，无需注册。
  </p>

  <label for="diag-input" class="block text-sm font-medium text-slate-700 mb-2">
    输入手机号 / 座机号 / 400 / 95 号码
  </label>
  <div class="flex flex-col sm:flex-row gap-3">
    <input
      id="diag-input"
      type="tel"
      inputmode="tel"
      autocomplete="off"
      placeholder="如 13800138000 或 010-12345678"
      class="flex-1 px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-400 text-lg"
    />
    <button
      id="diag-btn"
      type="button"
      class="px-6 py-3 bg-brand-600 text-white rounded-lg font-medium hover:bg-brand-700 transition-colors whitespace-nowrap"
    >
      识别号码
    </button>
  </div>
  <p class="text-xs text-slate-400 mt-2">
    本向导只识别号码类型与号段，不查询真实标记。真实标记状态需通过下方渠道在各平台官方页面查询。
  </p>

  <div id="diag-result" class="hidden mt-5" aria-live="polite"></div>
</div>

<script>
  (function () {
    var root = document.getElementById('diag-root');
    if (!root) return;
    var input = document.getElementById('diag-input');
    var btn = document.getElementById('diag-btn');
    var box = document.getElementById('diag-result');
    if (!input || !btn || !box) return;

    var MODE = root.getAttribute('data-mode') === 'clear' ? 'clear' : 'check';
    var SERVICE = root.getAttribute('data-service') || '';

    // 手机号段 → 运营商(仅用于展示号码归属运营商, 非归属地)
    var SEGMENTS = {
      134: '中国移动', 135: '中国移动', 136: '中国移动', 137: '中国移动', 138: '中国移动', 139: '中国移动',
      147: '中国移动', 148: '中国移动', 150: '中国移动', 151: '中国移动', 152: '中国移动', 157: '中国移动',
      158: '中国移动', 159: '中国移动', 172: '中国移动', 178: '中国移动', 182: '中国移动', 183: '中国移动',
      184: '中国移动', 187: '中国移动', 188: '中国移动', 195: '中国移动', 197: '中国移动', 198: '中国移动',
      165: '中国移动（虚拟运营商）',
      130: '中国联通', 131: '中国联通', 132: '中国联通', 145: '中国联通', 146: '中国联通', 155: '中国联通',
      156: '中国联通', 166: '中国联通', 175: '中国联通', 176: '中国联通', 185: '中国联通', 186: '中国联通',
      196: '中国联通', 167: '中国联通（虚拟运营商）', 171: '中国联通（虚拟运营商）',
      133: '中国电信', 149: '中国电信', 153: '中国电信', 173: '中国电信', 174: '中国电信', 177: '中国电信',
      180: '中国电信', 181: '中国电信', 189: '中国电信', 190: '中国电信', 191: '中国电信', 193: '中国电信',
      199: '中国电信', 162: '中国电信（虚拟运营商）',
      170: '虚拟运营商（170号段）',
    };

    // 本地识别: 返回 { type, label, seg } 或 null
    function classify(raw) {
      var d = String(raw || '').replace(/[^\d+]/g, '');
      if (d.indexOf('+86') === 0) d = d.slice(3);
      else if (d.indexOf('0086') === 0) d = d.slice(4);
      else if (d.indexOf('86') === 0 && d.length > 11) d = d.slice(2);
      d = d.replace(/\D/g, '');
      if (!d) return null;

      // 400 / 800 企业客服号
      if (/^400\d{7}$/.test(d)) return { type: '400 企业客服号', label: '400 号码', seg: '企业客服号段' };
      if (/^800\d{7}$/.test(d)) return { type: '800 企业客服号', label: '800 号码', seg: '企业客服号段' };
      // 95 / 96 短号企业客服
      if (/^(95|96)\d{3,6}$/.test(d)) return { type: '95/96 企业客服号', label: '95/96 号码', seg: '企业客服号段' };
      // 国际号码(带 + 且非 +86)
      if (/^\+\d{7,15}$/.test(String(raw).replace(/[^\d+]/g, ''))) {
        return { type: '国际号码', label: '国际号码', seg: '境外号码' };
      }
      // 手机号
      if (/^1[3-9]\d{9}$/.test(d)) {
        var seg = SEGMENTS[d.slice(0, 3)] || '';
        return { type: '手机号', label: '手机号', seg: seg || '国内手机号段' };
      }
      // 座机(固话): 0 + 区号(2-3位) + 7-8位
      if (/^0\d{2,3}\d{7,8}$/.test(d)) {
        var ac = d.slice(0, d.length >= 11 ? 4 : 3);
        return { type: '座机（固话）', label: '座机/固话', seg: '区号 ' + ac };
      }
      return null;
    }

    function channelsHtml(type) {
      var isCheck = MODE !== 'clear';
      var items = [];
      items.push(
        '<li><a class="text-brand-600 hover:underline" href="' + SERVICE + '" target="_blank" rel="noopener">' +
          (isCheck ? '标记查询服务' : '标记清除服务') +
        '</a> — 手机号与座机均支持，推荐优先使用</li>'
      );
      items.push(
        '<li><a class="text-brand-600 hover:underline" href="https://www.opene164.org.cn" target="_blank" rel="noopener nofollow">中国信通院码号服务推进组</a> — 官方跨平台' + (isCheck ? '查询' : '申诉') + '入口</li>'
      );
      if (type === '国际号码') {
        items.push(
          '<li><a class="text-brand-600 hover:underline" href="' +
          (isCheck ? 'https://www.truecaller.com/search' : 'https://www.truecaller.com/unlisting') +
          '" target="_blank" rel="noopener nofollow">Truecaller</a> — 海外标记' + (isCheck ? '查询' : '取消收录') + '</li>'
        );
      }
      var extra = '';
      if (type === '400 企业客服号' || type === '800 企业客服号' || type === '95/96 企业客服号') {
        extra =
          '<div class="bg-amber-50 border border-amber-200 rounded p-3 text-sm text-amber-700">' +
          '企业客服号被标记多因高频外呼触发。除清除标记外，建议同步办理企业号码认证，来电显示公司名称，可显著降低复标率。' +
          '</div>';
      }
      var tail = isCheck
        ? '<a class="text-brand-600 hover:underline" href="/tools/marking-clear/">确认被误标后前往标记清除 →</a>'
        : '<a class="text-brand-600 hover:underline" href="/tools/marking-check/">清除前先自查标记范围 →</a>';
      return (
        '<div class="bg-slate-50 border border-slate-200 rounded-lg p-4">' +
          '<p class="text-sm font-medium text-slate-700 mb-2">建议' + (isCheck ? '查询' : '清除') + '渠道</p>' +
          '<ul class="space-y-2 text-sm text-slate-600 list-none">' + items.join('') + '</ul>' +
        '</div>' +
        (extra ? '<div class="mt-3">' + extra + '</div>' : '') +
        '<p class="text-sm mt-3">' + tail + '</p>'
      );
    }

    function render(info, formatted) {
      var rows = [
        ['号码', formatted],
        ['号码类型', info.type],
        ['号段 / 运营商', info.seg],
      ];
      var grid = rows
        .map(function (r) {
          return (
            '<div><span class="text-slate-500 text-sm">' + r[0] + '</span>' +
            '<p class="font-medium ' + (r[0] === '号码' ? 'font-mono' : '') + '">' + r[1] + '</p></div>'
          );
        })
        .join('');
      box.innerHTML =
        '<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-4">' + grid + '</div>' +
        channelsHtml(info.type);
      box.classList.remove('hidden');
    }

    function error(msg) {
      box.innerHTML =
        '<div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">' + msg + '</div>';
      box.classList.remove('hidden');
    }

    var running = false;
    async function diagnose() {
      var raw = input.value.trim();
      if (!raw) {
        input.focus();
        return;
      }
      if (running) return;
      running = true;
      btn.disabled = true;
      btn.textContent = '识别中...';

      var info = classify(raw);
      var formatted = raw;

      // 用 libphonenumber-js 归一化展示(可选增强, 失败不影响本地识别)
      try {
        var mod = await import('libphonenumber-js/min');
        var pn = mod.parsePhoneNumberFromString(raw, 'CN');
        if (pn && pn.isValid()) {
          formatted = pn.formatInternational();
          if (!info) {
            info = { type: pn.getType() === 'mobile' ? '手机号' : '号码', label: '号码', seg: '中国 (+86)' };
          }
        }
      } catch (e) {
        /* 离线或加载失败时, 退回纯本地识别 */
      }

      if (!info) {
        error('未识别为有效的中国号码，请检查后重试（手机号 11 位，座机需带区号，如 010-12345678）。');
      } else {
        render(info, formatted);
      }
      btn.disabled = false;
      btn.textContent = '识别号码';
      running = false;
    }

    btn.addEventListener('click', diagnose);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') diagnose();
    });
  })();
</script>
