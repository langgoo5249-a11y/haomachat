---
// CustomerServiceFloat - 全局右下角客服悬浮按钮
// 点击弹出客服面板: 微信二维码 + 联系方式 + 快捷入口
---
<!-- 悬浮客服按钮 -->
<button
  id="cs-fab"
  aria-label="联系客服"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-brand-600 text-white shadow-lg hover:bg-brand-700 flex items-center justify-center transition-all hover:scale-110"
>
  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM10 9a1 1 0 11-2 0 1 1 0 012 0zm4 0a1 1 0 11-2 0 1 1 0 012 0z"/>
  </svg>
  <span class="absolute -top-1 -right-1 w-3 h-3 bg-green-400 rounded-full border-2 border-white"></span>
</button>

<!-- 弹出面板 -->
<div
  id="cs-panel"
  class="fixed bottom-24 right-6 z-50 w-72 bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden hidden"
>
  <!-- 头部 -->
  <div class="bg-brand-600 text-white px-5 py-4 flex items-center justify-between">
    <div>
      <h3 class="font-bold text-base">在线客服</h3>
      <p class="text-xs text-brand-100">工作日 9:00-18:00 在线</p>
    </div>
    <button id="cs-close" aria-label="关闭" class="text-brand-100 hover:text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- 微信二维码 -->
  <div class="px-5 py-4 text-center border-b border-slate-100">
    <img src="/images/customer-service-qr.png" alt="微信客服二维码 - 号码认证服务咨询" width="140" height="140" class="mx-auto rounded-lg border border-slate-200" loading="lazy" />
    <p class="text-sm text-slate-600 mt-2">微信扫码添加客服</p>
    <p class="text-xs text-slate-400">微信号: </p>
  </div>

  <!-- 联系方式 -->
  <div class="px-5 py-3 space-y-2 border-b border-slate-100">
    <a href="mailto:644428571@qq.com" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-600">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      644428571@qq.com
    </a>
    <a href="/contact" class="flex items-center gap-2 text-sm text-slate-600 hover:text-brand-600">
      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
      在线反馈表单
    </a>
  </div>

  <!-- 快捷入口 -->
  <div class="px-5 py-3 grid grid-cols-2 gap-2">
    <a href="/tools/marking-clear" class="text-center text-xs py-2 bg-brand-50 text-brand-700 rounded-lg hover:bg-brand-100">标记清除</a>
    <a href="/tools/legal-number-verify" class="text-center text-xs py-2 bg-brand-50 text-brand-700 rounded-lg hover:bg-brand-100">法人核验</a>
  </div>
</div>

<!-- 遮罩层 -->
<div id="cs-overlay" class="fixed inset-0 z-40 bg-black/20 hidden"></div>

<script is:inline>
  (function() {
    const fab = document.getElementById('cs-fab');
    const panel = document.getElementById('cs-panel');
    const close = document.getElementById('cs-close');
    const overlay = document.getElementById('cs-overlay');

    function openPanel() {
      panel.classList.remove('hidden');
      overlay.classList.remove('hidden');
      fab.classList.add('opacity-0', 'pointer-events-none');
    }
    function closePanel() {
      panel.classList.add('hidden');
      overlay.classList.add('hidden');
      fab.classList.remove('opacity-0', 'pointer-events-none');
    }

    fab.addEventListener('click', openPanel);
    close.addEventListener('click', closePanel);
    overlay.addEventListener('click', closePanel);
  })();
</script>
