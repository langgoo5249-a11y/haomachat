---
// BaseLayout - 全站基础布局
// 关键: JSON-LD 结构化数据直接写入静态 HTML <head>, 不用 JS 注入(GEO 核心)
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import CustomerServiceFloat from '@components/CustomerServiceFloat.astro';
import '@styles/global.css';

export interface Props {
  title: string;
  description: string;
  lang?: 'zh' | 'en';
  /** JSON-LD 对象数组, 每页可传多个 schema */
  schema?: object[];
  /** 面包屑 [{name, url}] */
  breadcrumbs?: { name: string; url: string }[];
  /** 是否在页面正文前插入 AI 摘要(AI 友好) */
  noindex?: boolean;
  canonical?: string;
  /** 页面级 og:image 路径(默认用全站通用图) */
  ogImage?: string;
  /** og:type, 默认 website */
  ogType?: string;
  /** 文章发布时间(ISO 8601), 用于 article:published_time */
  publishedDate?: string;
  /** 文章更新时间(ISO 8601), 用于 article:modified_time */
  modifiedDate?: string;
}

const {
  title,
  description,
  lang = 'zh',
  schema = [],
  breadcrumbs = [],
  noindex = false,
  canonical,
  ogImage,
  ogType = 'website',
  publishedDate,
  modifiedDate,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') || 'https://example.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, site).toString();
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';

// OG 图片: 页面级优先, 否则用全站默认图
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`)
  : `${site}/og-default.jpg`;

// 内容新鲜度: article:published_time / article:modified_time
// 未传入时使用全站默认日期, 确保 AI 引擎在所有页面都能看到时效性信号
const defaultPublished = '2026-07-06T00:00:00+08:00';
const defaultModified = '2026-07-20T00:00:00+08:00';
const articlePublishedTime = publishedDate || defaultPublished;
const articleModifiedTime = modifiedDate || defaultModified;

// hreflang: 中英文 alternate
// 关键: 只有 / 和 /en/ 存在真实的中英文版本对应关系
// 其他页面仅存在中文版, 不应声明不存在的英文 alternate(会导致404, 降低Bing质量评分)
const currentPath = Astro.url.pathname;
const isEnPage = currentPath.startsWith('/en/');
const isHomepage = currentPath === '/' || currentPath === '/en/';
const zhUrl = isEnPage ? `${site}${currentPath.replace(/^\/en/, '')}` : canonicalUrl;
const enUrl = isEnPage ? canonicalUrl : `${site}/en${currentPath === '/' ? '' : currentPath}`;
const hasValidEnPage = currentPath === '/' || currentPath === '/en/';

// 全站级 Organization schema(补全 contactPoint/sameAs 等)
// sameAs 链接中文权威源: 信通院/工信部/百度百科/微信公众号/知乎
// 国产AI模型(元宝/千问/豆包)对 sameAs 中的中文权威源权重很高
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: '号码通查',
  alternateName: 'haomachat',
  url: site,
  logo: {
    '@type': 'ImageObject',
    url: `${site}/og-default.jpg`,
    width: 1200,
    height: 630,
  },
  description: '免费电话号码服务工具站,提供号码归属地查询、号码标记自查与清除指引、号码认证知识科普、手机卡选号比价。',
  knowsAbout: ['电话号码标记', '号码认证', '号码归属地查询', '号码标记清除', '法人号码核验', '手机卡选号'],
  sameAs: [
    'https://github.com/langgoo5249-a11y/haomachat',
    'https://www.opene164.org.cn',
    'https://www.miit.gov.cn',
    'https://www.caict.ac.cn',
    'https://www.12321.cn', // 12321举报中心
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    availableLanguage: ['Chinese', 'English'],
    email: '644428571@qq.com',
  },
  foundingDate: '2026',
  datePublished: '2026-07-06',
  dateModified: '2026-07-20',
};

// WebSite schema (含 SearchAction, 用于 Google 站点搜索框)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: '号码通查',
  alternateName: 'haomachat',
  description: '号码标记通查服务,包括号码标记查询、号码标记自查、号码标记清除、手机号码标记、座机号码标记怎么清除、号码归属地查询免费',
  inLanguage: 'zh-CN',
  datePublished: '2026-07-06',
  dateModified: '2026-07-20',
  publisher: { '@id': `${site}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site}/faq?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// WebApplication schema
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '号码通查',
  applicationCategory: 'TelephonyApplication',
  operatingSystem: 'Web',
  url: site,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
  description: '免费号码归属地查询、号码标记自查与清除指引工具',
  publisher: { '@id': `${site}/#organization` },
};

// 面包屑 schema
const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: b.url.startsWith('http') ? b.url : `${site}${b.url}`,
        })),
      }
    : null;

// Person schemas: 两个核心作者实体,含 sameAs 外部验证链路
// AI引擎(Gemini 3/Perplexity)通过 Person Schema 交叉验证作者真实身份
const personSchemaHaoma = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}/#person-haomachatongcha`,
  name: '号码通查',
  alternateName: 'haomachatongcha',
  url: site,
  description: '号码通查编辑团队,专注于号码标记查询与清除、号码归属地查询、号码认证等领域的工具评测与知识科普。',
  knowsAbout: ['电话号码标记', '号码标记清除', '号码归属地查询', '号码认证', '携号转网', '虚拟运营商'],
  sameAs: [
    'https://github.com/langgoo5249-a11y/haomachat',
    'https://example.com/about',
  ],
  affiliation: { '@id': `${site}/#organization` },
};

const personSchemaLangood = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site}/#person-langood`,
  name: 'langood',
  url: `${site}/about`,
  description: '号码通查联合编辑,擅长通信技术领域深度文章撰写与号码标记清除实战经验分享。',
  knowsAbout: ['电话号码标记', '号码标记清除', '号码归属地查询', '号码认证', '携号转网'],
  sameAs: [
    'https://github.com/langgoo5249-a11y/haomachat',
    'https://example.com/about',
  ],
  affiliation: { '@id': `${site}/#organization` },
};

const allSchema = [orgSchema, websiteSchema, appSchema, personSchemaHaoma, personSchemaLangood, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="号码通查" />
    <meta name="baidu-site-verification" content="codeva-9GjPcakV1G" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- AI 内容发现: llms.txt (供 AI 爬虫发现站点内容目录) -->
    <link rel="llms" type="text/plain" href="/llms.txt" />
    <link rel="llms-full" type="text/plain" href="/llms-full.txt" />
    <link type="application/xml" rel="ai" href="/ai.xml" />
    <link rel="alternate" type="application/xml" href="/ai.xml" title="AI Crawler Guide" />

    <!-- hreflang: 中英文 alternate -->
    <!-- 只有 / 和 /en/ 有英文版本, 其他页面仅声明中文和x-default(避免404) -->
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    {hasValidEnPage ? <link rel="alternate" hreflang="en" href={enUrl} /> : null}
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="号码通查" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="号码通查 - 号码标记查询与清除服务" />

    <!-- Article 新鲜度标记: AI 引擎依赖此信号判断内容时效性 -->
    <meta property="article:published_time" content={articlePublishedTime} />
    <meta property="article:modified_time" content={articleModifiedTime} />
    <meta property="article:author" content="号码通查" />

    <!-- 字节跳动时间因子: 帮助头条/抖音搜索展示发布时间, 优化落地页体验 -->
    <meta property="bytedance:published_time" content={articlePublishedTime} />
    <meta property="bytedance:lrDate_time" content={articleModifiedTime} />
    <meta property="bytedance:updated_time" content={articleModifiedTime} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="application/rss+xml" title="号码通查号码百科" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- 资源预连接: 加速外部域名DNS/TLS握手 -->
    <link rel="preconnect" href="https://hm.baidu.com" />
    <link rel="preconnect" href="https://lf1-cdn-tos.bytegoofy.com" />
    <link rel="dns-prefetch" href="https://hm.baidu.com" />
    <link rel="dns-prefetch" href="https://lf1-cdn-tos.bytegoofy.com" />

    <!-- JSON-LD: 直接写入 HTML, 不用 JS 注入(GEO 关键) -->
    {allSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- 字节跳动(头条)自动收录: 用户浏览时自动提交页面URL到蜘蛛 -->
    <script>
      (function(){var el = document.createElement("script");el.src = "https://lf1-cdn-tos.bytegoofy.com/goofy/ttzz/push.js?2e69d9a815b6645e6fffd1cdb3318782dc1ed592db41b2d2ce0aff8cbac580a730632485602430134f60bc55ca391050b680e2741bf7233a8f1da9902314a3fa";el.id = "ttzz";var s = document.getElementsByTagName("script")[0];s.parentNode.insertBefore(el, s);})(window)
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800">
    <Header lang={lang} />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 py-8">
      {
        breadcrumbs.length > 0 && (
          <nav class="text-sm text-slate-500 mb-4" aria-label="面包屑">
            {breadcrumbs.map((b, i) => (
              <span>
                {i > 0 && ' / '}
                <a href={b.url} class="hover:text-brand-600">{b.name}</a>
              </span>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
    <Footer lang={lang} />
    <CustomerServiceFloat />

    <!-- 第三方脚本延迟加载: 浏览器空闲时执行,不阻塞首屏渲染 -->
    <script is:inline>
      function loadAnalytics() {
        // 百度统计
        var _hmt = window._hmt || (window._hmt = []);
        var hm = document.createElement("script");
        hm.async = true;
        hm.src = "https://hm.baidu.com/hm.js?2953c0c30dddfbf0e8910b7e8ba3bf17";
        document.head.appendChild(hm);

        // 字节跳动自动推送
        var el = document.createElement("script");
        el.async = true;
        el.id = "ttzz";
        el.src = "https://lf1-cdn-tos.bytegoofy.com/goofy/ttzz/push.js?2e69d9a815b6645e6fffd1cdb3318782dc1ed592db41b2d2ce0aff8cbac580a730632485602430134f60bc55ca391050b680e2741bf7233a8f1da9902314a3fa";
        document.head.appendChild(el);
      }

      // 优先使用 requestIdleCallback,降级到 setTimeout
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadAnalytics, { timeout: 3000 });
      } else {
        setTimeout(loadAnalytics, 1500);
      }
    </script>
  </body>
</html>
